  <button type="button" data-nav="panDown" title="Mover abajo" aria-label="Mover abajo">↓</button>
  <button type="button" data-nav="panRight" title="Mover derecha" aria-label="Mover derecha">→</button>
  <button type="button" data-nav="reset" title="Restablecer vista" aria-label="Restablecer vista">⌂</button>
</div>
<svg id="diagram" viewBox="0 0 4500 2050" role="img" aria-label="Diagrama genealógico bilateral de las familias Molina, Vallejo, Gana, Leay y Dublé">
<g id="viewport">
  <rect class="group-bg" x="45" y="65" width="1800" height="1840"/>
  <rect class="group-bg" x="1850" y="65" width="2620" height="1840"/>
  <line class="divider" x1="1847" y1="65" x2="1847" y2="1905"/>
