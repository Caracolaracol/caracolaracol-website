const edgeEls=[];const nodeEls=[];const edgeByNode={};
function pathFor(a,b,type){let x1=a.x,y1=a.y+H/2,x2=b.x,y2=b.y-H/2;if(type==='marriage'){x1=a.x+(a.x<=b.x?W/2:-W/2);y1=a.y;x2=b.x+(b.x<=a.x?W/2:-W/2);y2=b.y;return `M ${x1} ${y1} C ${(x1+x2)/2} ${y1}, ${(x1+x2)/2} ${y2}, ${x2} ${y2}`;}if(Math.abs(x2-x1)<10)return `M ${x1} ${y1} L ${x2} ${y2}`;const mid=(y1+y2)/2;return `M ${x1} ${y1} C ${x1} ${mid}, ${x2} ${mid}, ${x2} ${y2}`}
function labelPos(a,b,type){if(type==='marriage')return{x:(a.x+b.x)/2,y:(a.y+b.y)/2-9};return{x:(a.x+b.x)/2+8,y:(a.y+b.y)/2}}
function render(){
 const eg=document.getElementById('edges'),ng=document.getElementById('nodes');
 edges.forEach((e,i)=>{const [type,aid,bid,label]=e,a=byId[aid],b=byId[bid];const g=document.createElementNS('http://www.w3.org/2000/svg','g');g.classList.add('edge',type);g.dataset.rel=type;g.dataset.a=aid;g.dataset.b=bid;const p=document.createElementNS('http://www.w3.org/2000/svg','path');p.setAttribute('d',pathFor(a,b,type));g.appendChild(p);const pos=labelPos(a,b,type);const text=document.createElementNS('http://www.w3.org/2000/svg','text');text.setAttribute('x',pos.x);text.setAttribute('y',pos.y);text.setAttribute('class','edge-label '+type);text.textContent=label;g.appendChild(text);eg.appendChild(g);edgeEls.push(g);(edgeByNode[aid]??=[]).push(g);(edgeByNode[bid]??=[]).push(g)});
 nodes.forEach(n=>{const g=document.createElementNS('http://www.w3.org/2000/svg','g');g.classList.add('node',n.k,n.c||'');if(n.gp)g.classList.add('grandparent');g.dataset.id=n.id;g.dataset.text=(n.t.join(' ')+' '+n.s.join(' ')).toLowerCase();g.setAttribute('transform',`translate(${n.x-W/2},${n.y-H/2})`);const r=document.createElementNS('http://www.w3.org/2000/svg','rect');r.setAttribute('width',W);r.setAttribute('height',H);g.appendChild(r);const title=document.createElementNS('http://www.w3.org/2000/svg','text');title.setAttribute('x',14);title.setAttribute('y',27);title.setAttribute('class','title');if(n.t[0].length>23){title.setAttribute('font-size','12');title.setAttribute('textLength','180');title.setAttribute('lengthAdjust','spacingAndGlyphs')}title.textContent=n.t[0];g.appendChild(title);const sub=document.createElementNS('http://www.w3.org/2000/svg','text');sub.setAttribute('x',14);sub.setAttribute('y',46);sub.setAttribute('class','sub');n.s.slice(0,2).forEach((line,i)=>{const span=document.createElementNS('http://www.w3.org/2000/svg','tspan');span.setAttribute('x',14);span.setAttribute('dy',i===0?0:14);span.textContent=line;sub.appendChild(span)});g.appendChild(sub);const bg=document.createElementNS('http://www.w3.org/2000/svg','rect');bg.setAttribute('x',14);bg.setAttribute('y',76);bg.setAttribute('width',88);bg.setAttribute('height',18);bg.setAttribute('class','badge-bg');g.appendChild(bg);const badge=document.createElementNS('http://www.w3.org/2000/svg','text');badge.setAttribute('x',21);badge.setAttribute('y',89);badge.setAttribute('class','badge');badge.textContent=n.k==='direct'?'DIRECTA':n.k==='marriage'?'MATRIM.':n.k==='collateral'?'COLATERAL':n.k==='indirect'?'INDIRECTA':'PROVISIONAL';g.appendChild(badge);ng.appendChild(g);nodeEls.push(g);g.addEventListener('click',()=>select(n.id))});
}
render();
let enabled=new Set(['direct','marriage','collateral','indirect','provisional']);let selected=null;
function refresh(){const q=document.getElementById('search').value.trim().toLowerCase();edgeEls.forEach(e=>{const on=enabled.has(e.dataset.rel);e.classList.toggle('dim',!on)});nodeEls.forEach(n=>{const match=!q||n.dataset.text.includes(q);n.classList.toggle('dim',!!q&&!match);n.classList.toggle('match',!!q&&match);n.classList.toggle('selected',n.dataset.id===selected)});if(selected){const near=new Set([selected]);(edgeByNode[selected]||[]).forEach(e=>{near.add(e.dataset.a);near.add(e.dataset.b)});nodeEls.forEach(n=>n.classList.toggle('dim',!near.has(n.dataset.id)&&!q));edgeEls.forEach(e=>e.classList.toggle('dim',!near.has(e.dataset.a)&&!near.has(e.dataset.b)))}document.getElementById('status').textContent=selected?'Seleccionado: '+(byId[selected].t[0]):q?`Coincidencias: ${nodeEls.filter(n=>n.classList.contains('match')).length}`:'Vista bilateral: dos abuelos con el mismo peso visual'}
function showDetail(id){const panel=document.getElementById('detail'),img=document.getElementById('detailImage'),noImage=document.getElementById('detailNoImage'),caption=document.getElementById('detailCaption'),title=document.getElementById('detailTitle'),kind=document.getElementById('detailKind'),bio=document.getElementById('detailBio'),relation=document.getElementById('detailRelation').querySelector('span');if(!id){panel.classList.remove('open');return}const n=byId[id],d=details[id]||{bio:n.s.join('. ')};const kinds={direct:'Parentesco directo',marriage:'Vínculo matrimonial',collateral:'Rama colateral',indirect:'Conexión histórica indirecta',provisional:'Filiación provisional'};title.textContent=n.t[0];kind.textContent=kinds[n.k]||'Conexión familiar';bio.textContent=d.bio;relation.textContent=d.relation||n.s.join(' · ');img.hidden=!d.image;noImage.hidden=!!d.image;caption.textContent=d.image?'Imagen histórica · Wikimedia Commons':'';if(d.image){img.src=d.image;img.alt='Imagen de '+n.t[0]}panel.classList.add('open')}
function select(id){selected=selected===id?null:id;showDetail(selected);refresh()}
function closeDetail(){selected=null;showDetail(null);refresh()}
document.getElementById('detailClose').addEventListener('click',closeDetail);document.getElementById('detail').addEventListener('click',e=>{if(e.target.id==='detail')closeDetail()});document.addEventListener('keydown',e=>{if(e.key==='Escape'&&selected)closeDetail()})
document.querySelectorAll('.toggle').forEach(b=>b.addEventListener('click',()=>{const r=b.dataset.rel;if(enabled.has(r)){enabled.delete(r);b.classList.remove('active')}else{enabled.add(r);b.classList.add('active')}refresh()}));document.getElementById('search').addEventListener('input',()=>{selected=null;showDetail(null);refresh()});document.getElementById('reset').addEventListener('click',()=>{selected=null;showDetail(null);document.getElementById('search').value='';enabled=new Set(['direct','marriage','collateral','indirect','provisional']);document.querySelectorAll('.toggle').forEach(b=>b.classList.add('active'));refresh();scale=1;tx=0;ty=0;applyTransform()});
document.getElementById('theme').addEventListener('click',()=>{const d=document.documentElement;const dark=d.dataset.theme==='dark';d.dataset.theme=dark?'':'dark';document.getElementById('theme').textContent=dark?'☾ Tema oscuro':'☀ Tema claro'});
const svg=document.getElementById('diagram'),vp=document.getElementById('viewport');let scale=1,tx=0,ty=0,drag=false,sx=0,sy=0,ox=0,oy=0;function applyTransform(){vp.setAttribute('transform',`translate(${tx} ${ty}) scale(${scale})`)}function zoomBy(factor){const next=Math.max(.42,Math.min(2.8,scale*factor));const cx=2250,cy=1025;tx+=(scale-next)*cx;ty+=(scale-next)*cy;scale=next;applyTransform()}function panBy(dx,dy){tx+=dx/scale;ty+=dy/scale;applyTransform()}document.querySelectorAll('[data-nav]').forEach(b=>b.addEventListener('click',()=>{const action=b.dataset.nav;if(action==='zoomIn')zoomBy(1.2);else if(action==='zoomOut')zoomBy(.83);else if(action==='panUp')panBy(0,-220);else if(action==='panDown')panBy(0,220);else if(action==='panLeft')panBy(-220,0);else if(action==='panRight')panBy(220,0);else{scale=1;tx=0;ty=0;applyTransform()}}));svg.addEventListener('wheel',e=>{e.preventDefault();zoomBy(e.deltaY<0?1.12:.89)},{passive:false});svg.addEventListener('pointerdown',e=>{if(e.target.closest('.node'))return;drag=true;svg.classList.add('dragging');sx=e.clientX;sy=e.clientY;ox=tx;oy=ty;svg.setPointerCapture(e.pointerId)});svg.addEventListener('pointermove',e=>{if(!drag)return;tx=ox+(e.clientX-sx)*2.2;ty=oy+(e.clientY-sy)*2.2;applyTransform()});svg.addEventListener('pointerup',()=>{drag=false;svg.classList.remove('dragging')});refresh();
</script>
