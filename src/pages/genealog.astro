const details={
juanPastene:{bio:'Navegante y explorador genovés al servicio de la Corona española. Participó en las primeras exploraciones de la costa del Pacífico sur, ejerció cargos militares y municipales en Santiago y es tradicionalmente reconocido como fundador de Valparaíso.',relation:'Conexión histórica indirecta por la cadena Pastene–Jaraquemada–Mendibil–Darrigrande.',image:'https://thumb.wikimedia.org/wikipedia/commons/thumb/4/4f/Juan_Bautista_Pastene.jpg/330px-Juan_Bautista_Pastene.jpg',source:'https://es.wikipedia.org/wiki/Juan_Bautista_Pastene'},
vicente:{bio:'Vicente García-Huidobro Fernández (1893–1948) fue poeta, ensayista y fundador del creacionismo. Su red familiar se conecta con este árbol por Mercedes García-Huidobro, hermana de Vicente y esposa de Diego Dublé Urrutia.',relation:'Conexión matrimonial colateral; no es antepasado sanguíneo probado.',image:'https://thumb.wikimedia.org/wikipedia/commons/thumb/6/61/Vicente_huidobro.jpg/330px-Vicente_huidobro.jpg',source:'https://es.wikipedia.org/wiki/Vicente_Huidobro'},
grove:{bio:'José Marmaduke Grove Vallejo (1878–1954) fue militar, aviador y político. Participó en la organización de la aviación militar chilena y fue una figura relevante del socialismo y de la República Socialista de 1932.',relation:'Conexión matrimonial mediante Ana Vallejo Burgoa, hermana de Hernán Vallejo Burgoa.',image:'https://thumb.wikimedia.org/wikipedia/commons/thumb/b/b1/Cdte._Marmaduke_Grove_.jpg/330px-Cdte._Marmaduke_Grove_.jpg',source:'https://es.wikipedia.org/wiki/Marmaduke_Grove'},
blanco:{bio:'Manuel Blanco Encalada (1790–1876) fue marino, almirante y político. Fue el primer Presidente de Chile y participó en las campañas de Independencia y en la organización de la escuadra chilena.',relation:'Conexión matrimonial mediante María del Carmen Gana y López.',image:'https://thumb.wikimedia.org/wikipedia/commons/thumb/9/9e/M._Blanco_Encalada.jpg/330px-M._Blanco_Encalada.jpg',source:'https://es.wikipedia.org/wiki/Manuel_Blanco_Encalada'},
allende:{bio:'Salvador Allende Gossens (1908–1973) fue médico, dirigente socialista y Presidente de Chile entre 1970 y 1973. Su trayectoria política marcó profundamente la historia chilena del siglo XX.',relation:'Conexión matrimonial colateral a través de la rama Vallejo–Corbalán Allende.',image:'https://upload.wikimedia.org/wikipedia/commons/0/0d/Salvador_Allende_Gossens-.jpg',source:'https://es.wikipedia.org/wiki/Salvador_Allende'},
blest:{bio:'Alberto Blest Gana (1830–1920) fue novelista, diplomático e intendente de Colchagua. Es considerado una figura fundacional de la novela chilena y escribió Martín Rivas, entre otras obras.',relation:'Conexión sanguínea colateral por María de la Luz Gana y López.',image:'https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c5/Alberto_Blest_Gana.jpeg/330px-Alberto_Blest_Gana.jpeg',source:'https://es.wikipedia.org/wiki/Alberto_Blest_Gana'},
diegoAlmeyda:{bio:'Diego Dublé Almeyda (1841–1922) fue militar y diplomático chileno. Participó en la Guerra del Pacífico y ocupó cargos militares y de representación; en esta red es hermano de Fresia Dublé Almeida.',relation:'Hermano de Fresia Dublé Almeida e hijo de Diego Nicasio Dublé Astorga.',image:'https://upload.wikimedia.org/wikipedia/commons/a/a7/Diego_Duble_Almeyda_-_FP.jpg',source:'https://es.wikipedia.org/wiki/Diego_Dublé_Almeyda'},
baldomero:{bio:'Baldomero Dublé Almeyda (1843–1881) fue militar chileno de la Guerra del Pacífico. Murió en la batalla de Chorrillos y recibió póstumamente los grados de coronel y otros honores militares.',relation:'Hermano de Fresia y Diego Dublé Almeyda; tío de Diego Dublé Urrutia.',image:'https://upload.wikimedia.org/wikipedia/commons/1/1e/Baldomero_y_Diego_Dubl%C3%A9_Almeyda_y_el_comandante_Ricardo_Santa_Cruz%2C_junto_al_proveedor_del_Ej%C3%A9rcito.jpg',source:'https://es.wikipedia.org/wiki/Baldomero_Dublé_Almeyda'},
diegoU:{bio:'Diego Dublé Urrutia (1877–1967) fue poeta, escritor, diplomático y Premio Nacional de Literatura de 1958. Su obra incluye poemas vinculados a la experiencia de la Guerra del Pacífico.',relation:'Descendiente de la rama Dublé y cuñado de Vicente Huidobro.',image:'https://thumb.wikimedia.org/wikipedia/commons/thumb/7/73/D._Duble_Urrutia.JPG/330px-D._Duble_Urrutia.JPG',source:'https://es.wikipedia.org/wiki/Diego_Dublé_Urrutia'},
agustinCarlos:{bio:'Agustín Carlos Edwards Mac-Clure (c. 1878–1941) fue empresario periodístico, economista, banquero, diplomático y político. Fundó El Mercurio de Santiago y otros diarios, fue ministro y embajador, y presidió la Asamblea de la Liga de las Naciones en 1922.',relation:'Suegro de Agustín Roberto Edwards Budge; conexión matrimonial con la rama Eastman.',image:'https://upload.wikimedia.org/wikipedia/commons/e/e3/AEdwardMC.jpg',source:'https://es.wikipedia.org/wiki/Agustín_Edwards_Mac-Clure'},
agustinEastman:{bio:'Agustín Edwards Eastman (1927–2017) fue periodista y director de El Mercurio de Santiago durante décadas. También presidió la Empresa El Mercurio y fue una de las figuras más influyentes de la prensa chilena contemporánea.',relation:'Descendiente de la unión Eastman–Edwards; conexión colateral con la rama Gana–Eastman.',image:'https://thumb.wikimedia.org/wikipedia/commons/thumb/4/4e/15-01-14-Agust%C3%ADn_Edwards_Eastman.jpg/330px-15-01-14-Agust%C3%ADn_Edwards_Eastman.jpg',source:'https://es.wikipedia.org/wiki/Agustín_Edwards_Eastman'},
arturoPrat:{bio:'Arturo Prat Chacón (1848–1879) fue comandante de la corbeta Esmeralda y murió durante el combate naval de Iquique, convirtiéndose en uno de los principales héroes navales de Chile.',relation:'Conexión matrimonial: Carlos Prat Echaurren, casado con María Luz Gana Subercaseaux, era su nieto.',image:'https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c9/Arturo_Prat_con_espada.jpg/330px-Arturo_Prat_con_espada.jpg',source:'https://es.wikipedia.org/wiki/Arturo_Prat'},
mariaLuzPrat:{bio:'María Luz Gana Subercaseaux pertenece a una rama colateral descendiente de Federico Gana Gana. Su matrimonio con Carlos Prat Echaurren enlaza la red Gana con la familia del héroe naval Arturo Prat.',relation:'Descendiente colateral de Federico Gana y vínculo matrimonial con la familia Prat.'},
carlosPrat:{bio:'Carlos Prat Echaurren pertenece a la familia Prat y fue nieto de Arturo Prat Chacón. Su matrimonio con María Luz Gana Subercaseaux establece la conexión entre ambas familias.',relation:'Esposo de María Luz Gana Subercaseaux y nieto de Arturo Prat Chacón.'},
anibalPinto:{bio:'Aníbal Pinto Garmendia (1825–1884) fue abogado, intendente de Concepción, ministro de Guerra y Marina y Presidente de Chile entre 1876 y 1881. Durante su gobierno comenzó la Guerra del Pacífico.',relation:'Conexión por matrimonio y red Zañartu: su esposa Delfina era hija de Josefa Zañartu; Pedro Zañartu se casó en segundas nupcias con María del Tránsito, hermana de Gertrudis, esposa de Ignacio Gana y López.',image:'https://thumb.wikimedia.org/wikipedia/commons/thumb/d/d6/Anibal_Pinto_3.jpg/330px-Anibal_Pinto_3.jpg',source:'https://es.wikipedia.org/wiki/Aníbal_Pinto'},
delfinaCruz:{bio:'Delfina Cruz Zañartu fue hija de José María de la Cruz Prieto y Josefa Zañartu Trujillo. Se casó con Aníbal Pinto Garmendia alrededor de 1851.',relation:'Esposa de Aníbal Pinto y descendiente de la rama Zañartu conectada por matrimonio con los Gana.'},
ignacioGana:{bio:'Ignacio Gana y López, hermano de Agustín Gana y López, fue diputado en 1829. Su matrimonio con Gertrudis Zañartu y Arrau abre la conexión indirecta con Aníbal Pinto.',relation:'Hermano de Agustín Gana y esposo de Gertrudis Zañartu y Arrau.'},
inesAllende:{bio:'Inés Allende Gossens fue hermana de Salvador Allende Gossens. Se casó con Eduardo Grove Vallejo, hijo de José Marmaduke Grove Avalos y Ana Vallejo Burgoa.',relation:'Hermana de Salvador Allende y esposa de Eduardo Grove Vallejo; conexión indirecta con la rama Vallejo–Grove.'},
eduardoGrove:{bio:'Eduardo Grove Vallejo fue hijo de José Marmaduke Grove Avalos y Ana Vallejo Burgoa. Su matrimonio con Inés Allende Gossens enlaza la rama Vallejo–Grove con la familia Allende.',relation:'Hijo de Ana Vallejo Burgoa y José Marmaduke Grove; esposo de Inés Allende Gossens.'},
maryRoseMacGill:{bio:'Mary Rose Mac-Gill Herrera (n. 1933) fue presidenta de la Corporación de Amigos del Teatro Municipal. En esta red se incorpora por su matrimonio con Julio Bernardo Subercaseaux Barros.',relation:'Conexión matrimonial colateral: su primer esposo, Julio Bernardo Subercaseaux Barros, desciende del mismo tronco Subercaseaux que Blanca Subercaseaux del Río, esposa de Federico Gana Gana.',image:'https://www.genealog.cl/Chile/M/MacGill/MacGillHerrera,MaryRose-www.genealogiachilenaenred.cl.jpg',source:'https://www.genealog.cl/Chile/M.html#MacGillHerrera,MaryRose'},
julioBernardoSub:{bio:'Julio Bernardo Subercaseaux Barros (1926–2012) fue abogado, diputado, ministro, intendente de Santiago, ministro de Minería, embajador en Turquía y senador. Fue el primer esposo de Mary Rose Mac-Gill Herrera.',relation:'Descendiente de Ramón Subercaseaux Mercado y del tronco Subercaseaux común con la rama de Blanca Subercaseaux del Río.'},
blancaSubRio:{bio:'Blanca Subercaseaux del Río fue hija de Francisco Subercaseaux de la Torre e Isolina del Río Racet. Se casó con Federico Gana Gana y fue madre de María Luz Gana Subercaseaux.',relation:'Esposa de Federico Gana Gana; su rama Subercaseaux enlaza indirectamente con Julio Bernardo Subercaseaux Barros.'},
juanM:{bio:'Juan Ignacio Molina (c. 1703–?) es el antepasado provisional situado al comienzo de la línea Molina. La filiación anterior a él y los nombres de sus padres permanecen sin identificar en las fuentes revisadas.',relation:'Antepasado provisional; la conexión con Agustín Molina Riquelme está documentada en la recopilación genealógica, pero requiere corroboración primaria.',image:'https://thumb.wikimedia.org/wikipedia/commons/thumb/7/71/Juan_Ignacio_Molina._Line_engraving_by_F._Rosaspina%2C_1805_%28cropped%29.jpg/330px-Juan_Ignacio_Molina._Line_engraving_by_F._Rosaspina%2C_1805_%28cropped%29.jpg',source:'https://es.wikipedia.org/wiki/Juan_Ignacio_Molina'},
agustinM:{bio:'Agustín Molina Riquelme (n. 1735) fue vecino y propietario. Genealog.cl lo registra como dueño de un sitio en El Almendral de Valparaíso y de propiedades en Valdivia, en la calle del Peligro.',relation:'Antepasado directo de José Molina Bocanegra y de la línea Molina.'},
juanr:{bio:'Juan Rafael Molina Varas (1822–1891) fue agente de Aduanas y tuvo una oficina en la calle Prat de Valparaíso.',relation:'Antepasado directo de Luis Antonio Molina López.'},
agustinGanaLopez:{bio:'Agustín Gana y López (1802–1884) fue militar. Combatió en Maipú, participó en la captura de la fragata María Isabel, sirvió en el Ejército Libertador del Perú y participó en las campañas de Chiloé y contra los Pincheira. Alcanzó el grado de teniente coronel y fue edecán del Presidente de la República.',relation:'Hermano de Manuel Segundo, María del Carmen e Ignacio Gana; rama colateral de la línea Gana.'},
federico:{bio:'Federico Gana Gana (1867–1926) fue abogado y escritor. Escribió cuentos de ambiente campesino como Días de campo y Manchas de color.',relation:'Rama colateral Gana; esposo de Blanca Subercaseaux del Río y padre de María Luz Gana Subercaseaux.'},
pedroZanartu:{bio:'Pedro Zañartu y Santa María fue presidente de la Asamblea Provincial de Concepción. Tuvo a Josefa Zañartu Trujillo con Petronila Trujillo y posteriormente se casó con María del Tránsito Zañartu y Arrau.',relation:'Antepasado de Delfina Cruz Zañartu por una rama indirecta; su segundo matrimonio enlaza con la familia Gana.'},
franciscoSubBreton:{bio:'Francisco Subercaseaux Breton (c. 1725–1800) fue médico y marino de la Real Armada Francesa. Llegó a Chile hacia 1757 y se dedicó a la minería y la agricultura en su estancia de Nantoco.',relation:'Tronco común de las dos ramas Subercaseaux que enlazan indirectamente a Mary Rose Mac-Gill con la familia Gana.'},
ramonSubMercado:{bio:'Ramón Subercaseaux Mercado (1790–1859) fue comerciante, propietario de la hacienda Pirque, alcalde de La Serena y senador por Coquimbo y Aconcagua. Presidió el Senado entre 1854 y 1855.',relation:'Antepasado de Julio Subercaseaux Browne y, por esa vía, de Julio Bernardo Subercaseaux Barros.'},
julioSubBrowne:{bio:'Julio Subercaseaux Browne (1870–1951) fue abogado, diputado y propietario del fundo Las Majadas de Pirque.',relation:'Antepasado de Julio Subercaseaux Aldunate y primer esposo de Mary Rose Mac-Gill por su descendencia.'},
william:{bio:'William Cunningham Blest fue médico y político chileno de origen irlandés. Su matrimonio con María de la Luz Gana y López enlazó la rama Gana con la familia Blest Gana.',relation:'Esposo de María de la Luz Gana y padre de Alberto Blest Gana.'},

camila:{bio:'Camila Antonia Amaranta Vallejo Dowling (n. Santiago, 1988) es geógrafa, dirigenta estudiantil y política chilena. Fue presidenta de la Federación de Estudiantes de la Universidad de Chile, diputada por el distrito 26 entre 2014 y 2022 y ministra secretaria general de Gobierno durante la administración de Gabriel Boric.',relation:'Prima del usuario, según dato familiar confirmado; se incorpora como conexión colateral de la rama Vallejo.',image:'https://upload.wikimedia.org/wikipedia/commons/1/1a/Camila_Vallejo_%282022%29.jpg',source:'https://commons.wikimedia.org/wiki/File:Camila_Vallejo_(2022).jpg'},
josefGanaOld:{bio:'José Francisco de Gana y Amézaga (también registrado como Juan Francisco de Gana) pasó a Chile hacia 1745 y se avecindó en Santiago. En 1757 viajó a España y visitó a su familia en Plencia; a su regreso compró en 1764 la estancia Santa Rita de Pirque a Pedro García de la Huerta por 30.000 pesos. Fue capitán de milicias y fundador de la familia Gana en Chile.',relation:'Antepasado directo de Agustín Domingo Gana y Darrigrande; tronco de la línea Gana chilena.'}
};
const edgeEls=[];const nodeEls=[];const edgeByNode={};
function pathFor(a,b,type,aid='',bid=''){const key=`${aid}->${bid}`;if(key==='josefGana->rosaD'){const x1=a.x+W/2,x2=b.x-W/2,y=a.y;return `M ${x1} ${y} C ${x1+180} ${y-90}, ${x2-180} ${y-90}, ${x2} ${y}`;}if(key==='enrique->federico'){const y1=a.y+H/2,y2=b.y-H/2,safeY=y1+60,safeX=b.x-W/2;return `M ${a.x} ${y1} C ${a.x} ${safeY}, ${a.x+150} ${safeY}, ${a.x+150} ${safeY} L ${safeX} ${safeY} L ${safeX} ${y2}`;}if(key==='mariaLuz->blest'){const y1=a.y+H/2,y2=b.y-H/2,safeX=a.x-100;return `M ${a.x} ${y1} C ${a.x-50} ${y1+30}, ${safeX} ${y1+60}, ${safeX} ${y1+90} L ${safeX} ${y2-90} C ${safeX} ${y2-60}, ${a.x-50} ${y2-30}, ${b.x} ${y2}`;}if(key==='blancaSubRio->federico'){const x1=a.x-W/2,y1=a.y,safeX=b.x+W/2,safeY=y1+100,wayX=safeX+295;return `M ${x1} ${y1} C ${x1} ${y1+60}, ${wayX} ${y1+60}, ${wayX} ${safeY} L ${safeX} ${safeY} L ${safeX} ${b.y}`;}let x1=a.x,y1=a.y+H/2,x2=b.x,y2=b.y-H/2;if(type==='marriage'){x1=a.x+(a.x<=b.x?W/2:-W/2);y1=a.y;x2=b.x+(b.x<=a.x?W/2:-W/2);y2=b.y;return `M ${x1} ${y1} C ${(x1+x2)/2} ${y1}, ${(x1+x2)/2} ${y2}, ${x2} ${y2}`;}if(Math.abs(x2-x1)<10)return `M ${x1} ${y1} L ${x2} ${y2}`;const mid=(y1+y2)/2;return `M ${x1} ${y1} C ${x1} ${mid}, ${x2} ${mid}, ${x2} ${y2}`}
function labelPos(a,b,type,aid='',bid=''){const key=`${aid}->${bid}`;if(key==='josefGana->rosaD')return{x:(a.x+b.x)/2,y:a.y-100};if(key==='enrique->federico')return{x:(a.x+b.x)/2,y:b.y+125};if(key==='mariaLuz->blest')return{x:a.x-100,y:b.y-110};if(type==='marriage')return{x:(a.x+b.x)/2,y:(a.y+b.y)/2-9};return{x:(a.x+b.x)/2+8,y:(a.y+b.y)/2}}
function render(){
 const eg=document.getElementById('edges'),ng=document.getElementById('nodes');
 edges.forEach((e,i)=>{const [type,aid,bid,label]=e,a=byId[aid],b=byId[bid];const g=document.createElementNS('http://www.w3.org/2000/svg','g');g.classList.add('edge',type);g.dataset.rel=type;g.dataset.a=aid;g.dataset.b=bid;const p=document.createElementNS('http://www.w3.org/2000/svg','path');p.setAttribute('d',pathFor(a,b,type,aid,bid));g.appendChild(p);const pos=labelPos(a,b,type,aid,bid);const text=document.createElementNS('http://www.w3.org/2000/svg','text');text.setAttribute('x',pos.x);text.setAttribute('y',pos.y);text.setAttribute('class','edge-label '+type);text.textContent=label;g.appendChild(text);eg.appendChild(g);edgeEls.push(g);(edgeByNode[aid]??=[]).push(g);(edgeByNode[bid]??=[]).push(g)});
 nodes.forEach(n=>{const g=document.createElementNS('http://www.w3.org/2000/svg','g');g.classList.add('node',n.k,n.c||'');if(n.gp)g.classList.add('grandparent');g.dataset.id=n.id;g.dataset.text=(n.t.join(' ')+' '+n.s.join(' ')).toLowerCase();g.setAttribute('transform',`translate(${n.x-W/2},${n.y-H/2})`);const r=document.createElementNS('http://www.w3.org/2000/svg','rect');r.setAttribute('width',W);r.setAttribute('height',H);g.appendChild(r);const title=document.createElementNS('http://www.w3.org/2000/svg','text');title.setAttribute('x',14);title.setAttribute('y',27);title.setAttribute('class','title');if(n.t[0].length>23){title.setAttribute('font-size','12');title.setAttribute('textLength','180');title.setAttribute('lengthAdjust','spacingAndGlyphs')}title.textContent=n.t[0];g.appendChild(title);const sub=document.createElementNS('http://www.w3.org/2000/svg','text');sub.setAttribute('x',14);sub.setAttribute('y',46);sub.setAttribute('class','sub');n.s.slice(0,2).forEach((line,i)=>{const span=document.createElementNS('http://www.w3.org/2000/svg','tspan');span.setAttribute('x',14);span.setAttribute('dy',i===0?0:14);span.textContent=line;sub.appendChild(span)});g.appendChild(sub);const bg=document.createElementNS('http://www.w3.org/2000/svg','rect');bg.setAttribute('x',14);bg.setAttribute('y',76);bg.setAttribute('width',88);bg.setAttribute('height',18);bg.setAttribute('class','badge-bg');g.appendChild(bg);const badge=document.createElementNS('http://www.w3.org/2000/svg','text');badge.setAttribute('x',21);badge.setAttribute('y',89);badge.setAttribute('class','badge');badge.textContent=n.k==='direct'?'DIRECTA':n.k==='marriage'?'MATRIM.':n.k==='collateral'?'COLATERAL':n.k==='indirect'?'INDIRECTA':'PROVISIONAL';g.appendChild(badge);ng.appendChild(g);nodeEls.push(g);g.addEventListener('click',()=>select(n.id))});
}
render();
let enabled=new Set(['direct','marriage','collateral','indirect','provisional']);let selected=null;
function refresh(){edgeEls.forEach(e=>{const on=enabled.has(e.dataset.rel);e.classList.toggle('dim',!on)});nodeEls.forEach(n=>{n.classList.remove('dim');n.classList.remove('match');n.classList.toggle('selected',n.dataset.id===selected)});if(selected){const near=new Set([selected]);(edgeByNode[selected]||[]).forEach(e=>{near.add(e.dataset.a);near.add(e.dataset.b)});nodeEls.forEach(n=>n.classList.toggle('dim',!near.has(n.dataset.id)));edgeEls.forEach(e=>e.classList.toggle('dim',!near.has(e.dataset.a)&&!near.has(e.dataset.b)))}document.getElementById('status').textContent=selected?'Seleccionado: '+(byId[selected].t[0]):'Vista bilateral: dos abuelos con el mismo peso visual'}
function showDetail(id){const panel=document.getElementById('detail'),img=document.getElementById('detailImage'),noImage=document.getElementById('detailNoImage'),caption=document.getElementById('detailCaption'),title=document.getElementById('detailTitle'),kind=document.getElementById('detailKind'),bio=document.getElementById('detailBio'),relation=document.getElementById('detailRelation').querySelector('span');if(!id){panel.classList.remove('open');return}const n=byId[id],d=details[id]||{bio:n.s.join('. ')};const kinds={direct:'Parentesco directo',marriage:'Vínculo matrimonial',collateral:'Rama colateral',indirect:'Conexión histórica indirecta',provisional:'Filiación provisional'};title.textContent=n.t[0];kind.textContent=kinds[n.k]||'Conexión familiar';bio.textContent=d.bio;relation.textContent=d.relation||n.s.join(' · ');img.hidden=!d.image;noImage.hidden=!!d.image;img.style.display=d.image?'block':'none';noImage.style.display=d.image?'none':'flex';caption.textContent=d.image?'Imagen histórica · Wikimedia Commons':'';if(d.image){img.src=d.image;img.alt='Imagen de '+n.t[0]}panel.classList.add('open')}
function select(id){selected=selected===id?null:id;showDetail(selected);refresh()}
function closeDetail(){selected=null;showDetail(null);refresh()}
document.getElementById('detailClose').addEventListener('click',closeDetail);document.getElementById('detail').addEventListener('click',e=>{if(e.target.id==='detail')closeDetail()});document.addEventListener('keydown',e=>{if(e.key==='Escape'&&selected)closeDetail()})
document.querySelectorAll('.toggle').forEach(b=>b.addEventListener('click',()=>{const r=b.dataset.rel;if(enabled.has(r)){enabled.delete(r);b.classList.remove('active')}else{enabled.add(r);b.classList.add('active')}refresh()}));document.getElementById('reset').addEventListener('click',()=>{selected=null;showDetail(null);enabled=new Set(['direct','marriage','collateral','indirect','provisional']);document.querySelectorAll('.toggle').forEach(b=>b.classList.add('active'));refresh();scale=initialScale;tx=initialTx;ty=initialTy;applyTransform()});
document.getElementById('theme').addEventListener('click',()=>{const d=document.documentElement;const dark=d.dataset.theme==='dark';d.dataset.theme=dark?'':'dark';document.getElementById('theme').textContent=dark?'☾ Tema oscuro':'☀ Tema claro'});
const svg=document.getElementById('diagram'),vp=document.getElementById('viewport');const initialScale=2.3,initialFocusX=1800,initialFocusY=1450,initialTx=3000-initialScale*initialFocusX,initialTy=1025-initialScale*initialFocusY;let scale=initialScale,tx=initialTx,ty=initialTy,drag=false,sx=0,sy=0,ox=0,oy=0,pointers=new Map(),pinch=null;const viewBoxW=6000,viewBoxH=2050;function applyTransform(){vp.setAttribute('transform',`translate(${tx} ${ty}) scale(${scale})`)}function svgPoint(x,y){const r=svg.getBoundingClientRect();return{x:(x-r.left)/r.width*viewBoxW,y:(y-r.top)/r.height*viewBoxH}}function setScale(next,cx=3000,cy=1025,baseScale=scale,baseTx=tx,baseTy=ty){scale=Math.max(.42,Math.min(8,next));const ratio=scale/baseScale;tx=cx-(cx-baseTx)*ratio;ty=cy-(cy-baseTy)*ratio;applyTransform()}function zoomAt(factor,cx,cy){setScale(scale*factor,cx,cy)}function zoomBy(factor){zoomAt(factor,3000,1025)}function panBy(dx,dy){tx+=dx/scale;ty+=dy/scale;applyTransform()}function pointerCenter(){const values=[...pointers.values()];return{x:(values[0].x+values[1].x)/2,y:(values[0].y+values[1].y)/2}}function pointerDistance(){const values=[...pointers.values()];return Math.hypot(values[0].x-values[1].x,values[0].y-values[1].y)}document.querySelectorAll('[data-nav]').forEach(b=>b.addEventListener('click',()=>{const action=b.dataset.nav;if(action==='zoomIn')zoomBy(1.2);else if(action==='zoomOut')zoomBy(.83);else if(action==='panUp')panBy(0,-220);else if(action==='panDown')panBy(0,220);else if(action==='panLeft')panBy(-220,0);else if(action==='panRight')panBy(220,0);else{scale=initialScale;tx=initialTx;ty=initialTy;applyTransform()}}));svg.addEventListener('wheel',e=>{e.preventDefault();const p=svgPoint(e.clientX,e.clientY);zoomAt(e.deltaY<0?1.12:.89,p.x,p.y)},{passive:false});svg.addEventListener('pointerdown',e=>{if(e.pointerType==='touch'||e.target.closest('.node'))return;e.preventDefault();pointers.set(e.pointerId,{x:e.clientX,y:e.clientY});svg.setPointerCapture(e.pointerId);if(pointers.size===1){drag=true;svg.classList.add('dragging');sx=e.clientX;sy=e.clientY;ox=tx;oy=ty}else if(pointers.size===2){drag=false;pinch={distance:pointerDistance(),center:svgPoint(...Object.values(pointerCenter())),scale,tx,ty};svg.classList.remove('dragging')}});svg.addEventListener('pointermove',e=>{if(e.pointerType==='touch'||!pointers.has(e.pointerId))return;e.preventDefault();pointers.set(e.pointerId,{x:e.clientX,y:e.clientY});if(pointers.size>=2&&pinch){const center=pointerCenter(),currentDistance=pointerDistance(),next=pinch.scale*(currentDistance/pinch.distance),centerSvg=svgPoint(center.x,center.y),startCenter=pinch.center;scale=Math.max(.42,Math.min(8,next));const ratio=scale/pinch.scale;tx=startCenter.x-(startCenter.x-pinch.tx)*ratio+(centerSvg.x-startCenter.x);ty=startCenter.y-(startCenter.y-pinch.ty)*ratio+(centerSvg.y-startCenter.y);applyTransform()}else if(drag){const p=pointers.get(e.pointerId);tx=ox+(p.x-sx)*4;ty=oy+(p.y-sy)*4;applyTransform()}});function endPointer(e){if(e.pointerType==='touch')return;pointers.delete(e.pointerId);if(pointers.size<2)pinch=null;if(pointers.size===1){const p=[...pointers.values()][0];drag=true;sx=p.x;sy=p.y;ox=tx;oy=ty;svg.classList.add('dragging')}else if(!pointers.size){drag=false;svg.classList.remove('dragging')}}svg.addEventListener('pointerup',endPointer);svg.addEventListener('pointercancel',endPointer);let touchDrag=false,touchStartX=0,touchStartY=0,touchOriginX=0,touchOriginY=0,touchPinch=null;function touchCenter(touches){return{x:(touches[0].clientX+touches[1].clientX)/2,y:(touches[0].clientY+touches[1].clientY)/2}}function touchDistance(touches){return Math.hypot(touches[0].clientX-touches[1].clientX,touches[0].clientY-touches[1].clientY)}svg.addEventListener('touchstart',e=>{if(e.target.closest('.node'))return;e.preventDefault();if(e.touches.length===1){const t=e.touches[0];touchDrag=true;touchStartX=t.clientX;touchStartY=t.clientY;touchOriginX=tx;touchOriginY=ty;svg.classList.add('dragging')}else if(e.touches.length>=2){const c=touchCenter(e.touches),p=svgPoint(c.x,c.y);touchDrag=false;touchPinch={distance:touchDistance(e.touches),center:p,scale,tx,ty};svg.classList.remove('dragging')}},{passive:false});svg.addEventListener('touchmove',e=>{if(!touchDrag&&!touchPinch)return;e.preventDefault();if(e.touches.length>=2&&touchPinch){const c=touchCenter(e.touches),p=svgPoint(c.x,c.y),next=touchPinch.scale*(touchDistance(e.touches)/touchPinch.distance);scale=Math.max(.42,Math.min(8,next));const ratio=scale/touchPinch.scale;tx=touchPinch.center.x-(touchPinch.center.x-touchPinch.tx)*ratio+(p.x-touchPinch.center.x);ty=touchPinch.center.y-(touchPinch.center.y-touchPinch.ty)*ratio+(p.y-touchPinch.center.y);applyTransform()}else if(e.touches.length===1&&touchDrag){const t=e.touches[0];tx=touchOriginX+(t.clientX-touchStartX)*4;ty=touchOriginY+(t.clientY-touchStartY)*4;applyTransform()}},{passive:false});svg.addEventListener('touchend',e=>{if(e.touches.length===1){const t=e.touches[0];touchPinch=null;touchDrag=true;touchStartX=t.clientX;touchStartY=t.clientY;touchOriginX=tx;touchOriginY=ty}else if(!e.touches.length){touchDrag=false;touchPinch=null;svg.classList.remove('dragging')}},{passive:false});svg.addEventListener('touchcancel',()=>{touchDrag=false;touchPinch=null;svg.classList.remove('dragging')},{passive:false});applyTransform();refresh();
</script>
