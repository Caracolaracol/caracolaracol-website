<body>
<header>
  <div><h1>Genealogía Molina–Gana</h1></div>
  <div class="actions"><button id="theme">☾ Tema oscuro</button><button id="reset">Restablecer vista</button><button id="menuBtn" class="menu-btn" aria-expanded="false" aria-controls="menuPanel" aria-label="Buscar y filtrar"><span class="burger" aria-hidden="true"><span></span><span></span><span></span></span><span class="menu-label">Buscar y filtrar</span></button></div>
  <div class="menu-panel" id="menuPanel" hidden>
    <label class="menu-title" for="search">Buscar persona</label>
    <input id="search" class="search" type="search" placeholder="Ej. Paula Jaraquemada · Enter para centrar" aria-label="Buscar persona en el árbol">
    <div class="menu-title">Mostrar relaciones</div>
    <div class="toggles" aria-label="Mostrar relaciones">
      <button class="toggle active" data-rel="direct">Directas</button>
      <button class="toggle active" data-rel="marriage">Matrimonios</button>
      <button class="toggle active" data-rel="collateral">Colaterales</button>
      <button class="toggle active" data-rel="indirect">Indirectas</button>
      <button class="toggle active" data-rel="provisional">Provisionales</button>
    </div>
    <div class="menu-title">Destacar</div>
    <div class="toggles"><button class="toggle-hist" id="histBtn" aria-pressed="false"><svg class="legend-star" viewBox="-11 -11 22 22" aria-hidden="true"><path d="M0 -10 L2.9 -4 L9.5 -3.1 L4.7 1.5 L5.9 8.1 L0 5 L-5.9 8.1 L-4.7 1.5 L-9.5 -3.1 L-2.9 -4 Z"/></svg> Solo personajes históricos</button></div>
    <span class="status" id="status">Haz clic en una persona para ver su ficha</span>
  </div>
</header>
<section class="legend" aria-label="Leyenda">
  <div class="legend-item"><span class="swatch"></span><strong>Parentesco directo</strong><span class="legend-desc">línea de sangre hasta los abuelos</span></div>
  <div class="legend-item"><span class="swatch marriage"></span><strong>Por matrimonio</strong><span class="legend-desc">unión conyugal, no sanguínea</span></div>
  <div class="legend-item"><span class="swatch collateral"></span><strong>Colateral</strong><span class="legend-desc">hermanos, tíos y primos</span></div>
  <div class="legend-item"><span class="swatch indirect"></span><strong>Indirecto</strong><span class="legend-desc">rama familiar o histórica lateral</span></div>
  <div class="legend-item"><span class="swatch provisional"></span><strong>Provisional</strong><span class="legend-desc">filiación por confirmar</span></div>
  <div class="legend-item"><span class="swatch originario"></span><strong>Pueblo originario</strong><span class="legend-desc">linaje indígena documentado</span></div>
  <div class="legend-item"><span class="swatch tramo"></span><strong>Tramo</strong><span class="legend-desc">tarjeta apilada que resume varias generaciones</span></div>
  <div class="legend-item"><span class="swatch unknownsw"></span><strong>Por investigar</strong><span class="legend-desc">línea que sigue, sin nombres aún</span></div>
  <div class="legend-item"><svg class="legend-star" viewBox="-11 -11 22 22" aria-hidden="true"><path d="M0 -10 L2.9 -4 L9.5 -3.1 L4.7 1.5 L5.9 8.1 L0 5 L-5.9 8.1 L-4.7 1.5 L-9.5 -3.1 L-2.9 -4 Z"/></svg><strong>Personaje histórico</strong><span class="legend-desc">figura con lugar propio en la historia</span></div>
</section>
<main>
<section class="diagram-shell" id="shell">
<div class="nav-controls" aria-label="Controles de navegación del árbol">
  <span class="nav-label">Vista</span>
  <button type="button" data-nav="zoomOut" title="Alejar" aria-label="Alejar">−</button>
  <button type="button" data-nav="zoomIn" title="Acercar" aria-label="Acercar">+</button>
  <button type="button" data-nav="panUp" title="Mover arriba" aria-label="Mover arriba">↑</button>
  <button type="button" data-nav="panLeft" title="Mover izquierda" aria-label="Mover izquierda">←</button>
  <button type="button" data-nav="panDown" title="Mover abajo" aria-label="Mover abajo">↓</button>
  <button type="button" data-nav="panRight" title="Mover derecha" aria-label="Mover derecha">→</button>
  <button type="button" data-nav="reset" title="Restablecer vista" aria-label="Restablecer vista">⌂</button>
</div>
<svg id="diagram" viewBox="0 0 7600 3760" role="img" aria-label="Diagrama genealógico de las familias Molina, Vallejo, Gana, Leay y Dublé">
<defs><pattern id="guarda" width="16" height="10" patternUnits="userSpaceOnUse"><rect class="guarda-bg" width="16" height="10"/><path class="guarda-fg" d="M0 5 L4 1 L8 5 L4 9 Z M8 5 L12 1 L16 5 L12 9 Z"/><rect class="guarda-bg" x="3" y="4" width="2" height="2"/><rect class="guarda-bg" x="11" y="4" width="2" height="2"/></pattern></defs>
<g id="viewport">
