const details={
robertoLeayB:{bio:'Roberto Eduardo Leay Bierwirth (n. c. 1881) fue ejecutivo de empresas; en 1918 vivía en calle Delicias N°325, Santiago. Se casó con Elvira Águeda Ehlers Dublé, hija de Carlos Ehlers Scheel y Fresia Dublé Almeida.',relation:'Antepasado directo: padre de Gladys Leay Ehlers.',source:'https://www.genealog.cl/Chile/L.html#LeayBierwirth,Roberto'},
leayPathisonBierwirth:{bio:'Roberto Eduardo Leay Pathison, escocés, nació hacia 1856; se lo cita como "inglés" y como comerciante entre 1885 y 1900, con domicilio sucesivo en Temuco, Concepción y Parral. Se casó con Ana Elisa Bierwirth [Badilla/Vadillo, n. c. 1860], hija de Eduardo Federico Rodolfo Bierwirth Tewes y Ana Perfecta Badilla Requena.',relation:'Antepasados directos: abuelos paternos de Gladys Leay Ehlers.',source:'https://www.genealog.cl/Chile/L.html#LeayPathison,Roberto'},
eduardoBierwirth:{bio:'Eduardo Federico Rodolfo Bierwirth Tewes nació el 29 de abril de 1835 en Hannover, Prusia (Alemania), hijo de Christian Enrique Bierwirth y María Elisa Tewes. Emigró a Nueva York en 1853 y se casó el 24 de julio de 1856 en Ciudad del Carmen, Campeche (México), con Ana Perfecta Badilla Requena; tuvieron al menos 6 hijos y 8 hijas. Vivió en Copiapó en 1861 y en Valparaíso desde 1871. Murió el 23 de mayo de 1900 en el Almendral (Los Andes) y fue enterrado en Valparaíso.',relation:'Antepasados directos: bisabuelos de Gladys Leay Ehlers, por su hija Ana Elisa Bierwirth.',image:'/genealog/eduardo-bierwirth.jpg',caption:'Retrato, s. XIX · foto de familia'},
nunezFonseca:{bio:'Antonio Núñez de Fonseca, nacido en el reino de Portugal, llegó a Chile en 1543 con el primer refuerzo de la conquista. Como alcalde de minas redactó en 1550 la primera ordenanza de minas del país, la primera legislación minera conocida en Chile. Fue naviero: tuvo un astillero en su estancia de Concón, junto a la desembocadura del Aconcagua, donde construyó barcos, y fue de los primeros en levantar bodegas en el puerto de Valparaíso. Hacia 1575–1590 fue el primer europeo instalado en las tierras del actual puerto de San Antonio, que heredó su hija María. En Santiago plantó un manzanal de cuatro cuadras, el “camuezal de Núñez”. Se casó con Juana Silva, hija de Amador de Silva, y tuvo además una hija natural mestiza, Inés.',relation:'Antepasado directo por la rama Borgoño: su hijo Luis Núñez de Silva es antepasado de María del Carmen Núñez Urrutia, madre de Juana Borgoño Núñez.',source:'https://www.genealog.cl/Apellidos/Nunez/#NunezdeFonseca,Antonio'},
inesNunez:{bio:'Inés Núñez, hija natural mestiza de Antonio Núñez de Fonseca y de una mujer indígena cuyo nombre no quedó registrado, se casó con Pedro de Silva y tuvo descendencia.',relation:'Medio hermana de Luis Núñez de Silva, antepasado directo. Rama colateral: el linaje indígena de su madre no pasa a la línea directa documentada.',source:'https://www.genealog.cl/Apellidos/Nunez/#NunezdeFonseca,Antonio'},
nunezChain:{bio:'Luis Núñez de Silva, hijo de Antonio Núñez de Fonseca y Juana Silva, fue capitán en el Maule, dueño de la estancia Carrizal y encomendero de Huenchullami; en 1609 se casó con Ana María de Loyola y Sedeño, nacida en Lima. Su hijo Pedro Núñez Sedeño (Talca, c. 1625 – Colchagua, 1671) se casó con Melchora Poblete y Meneses; el hijo de ambos, Juan Núñez de Silva y Poblete, se casó en Renca en 1689 con María Juana Garcés Pacheco. Luis Núñez de Silva y Garcés (Renca, 1705 – Petorca, 1777) se casó con Juana Margarita Pérez y Negrete y fue padre de Tadeo Núñez Pérez (Petorca, 1748), casado en 1772 con Josefa Catalina Urrutia Basurto, padres de María del Carmen Núñez Urrutia.',relation:'Tramo resumido de la línea directa entre Antonio Núñez de Fonseca y María del Carmen Núñez Urrutia.',source:'https://www.genealog.cl/Apellidos/Nunez/#NunezUrrutia,Carmen'},
borgonoNunez:{bio:'Francisco Antonio Borgoño y Encuentros (Aragón, c. 1747), llegado a Chile en 1783, se casó en la parroquia de Petorca el 4 de noviembre de 1788 con María del Carmen Núñez Urrutia. Fueron padres, entre otros, de Juana Borgoño Núñez y del general José Manuel Borgoño.',relation:'Antepasados directos: padres de Juana Borgoño Núñez, esposa de José Gregorio Amunátegui.',source:'https://www.genealog.cl/Chile/B/Borgono/#BorgonoEncuentros,FranciscoAntonio'},
prietoRomero:{bio:'José Francisco Prieto y de la Espriella fue bautizado en San Sebastián de Quintes (Asturias) en 1738 y vino a Chile como comandante de la Aduana de Valparaíso. En 1774 fue elegido por aclamación alcalde mayor y juez ordinario por el estado noble de Villaviciosa, cargo que no pudo asumir por estar en Chile. Se casó en Valparaíso en 1766 con María Isabel Romero Herrera, nacida en Petorca; viudo, volvió a casarse en 1806.',relation:'Antepasados directos: abuelos de Juana García Ortiz y Prieto, esposa de Tomás López Borrego.',source:'https://www.genealog.cl/Chile/P/Prieto/#PrietodelaEspriella,JoseFrancisco'},
garciaPrieto:{bio:'Manuel García-Ortiz, asturiano, se casó en 1796 con María Guadalupe Prieto Romero, hija de José Francisco Prieto y de la Espriella. Fueron padres de Juana y Dominga García Ortiz y Prieto.',relation:'Antepasados directos: padres de Juana García Ortiz y Prieto.',source:'https://www.genealog.cl/Apellidos/Garcia/#GarciaOrtiz,Manuel'},
prietoNovajas:{bio:'Juan José Prieto Romero, hermano de María Guadalupe Prieto Romero, se casó en 1798 con Isabel Novajas Velásquez, hija del alavés Modesto Novajas y Solano Blanco, teniente de ministro de Real Hacienda en Valparaíso, y de Rosa Velázquez Iglesias, descendiente de los encomenderos Velázquez de Chiloé.',relation:'Rama colateral: Juan José es tío de Juana García Ortiz y Prieto; por su esposa se enlaza con los descendientes de Álvaro Velázquez.',source:'https://www.genealog.cl/Chile/N.html#NovajasVelasquez,Isabel'},
alvaroVelazquez:{bio:'Álvaro Velázquez, nacido en España, llegó a la conquista de Chile y fue capitán y encomendero en Osorno en 1602. Amenazado por los indígenas alzados, que querían matarlo, se retiró de Osorno llevando consigo muchas familias y a sus indios hasta Chiloé, y se asentó donde se construyó el fuerte de Calbuco; por inquietudes de sus indios fue trasladado luego a la isla. En 1639 fue testigo en Lima en una información ante la Inquisición.',relation:'Conexión indirecta por matrimonio: es antepasado de Isabel Novajas Velásquez, esposa de Juan José Prieto Romero, tío de Juana García Ortiz y Prieto. No es antepasado directo.',source:'https://www.genealog.cl/Apellidos/Velazquez/#VelazquezIglesias,Rosa'},
velazquezChain:{bio:'Miguel Velázquez (+ c. 1683), capitán y encomendero en Chiloé, fue padre de Lorenzo Velázquez y Vargas, sargento mayor y vecino de Castro. Su hijo Domingo Velázquez y Roa, vecino de Valparaíso, murió en El Callao en 1720; el hijo de este, Domingo Velázquez, pasó a Valdivia en 1726 y se casó en Valparaíso con Petronila de los Reyes. Domingo Velázquez y Reyes (Valparaíso, 1734), piloto de la fragata Astrea y tesorero de las Cajas Reales de Chiloé, fue padre de Rosa Velázquez Iglesias (1761), casada en 1780 con Modesto Novajas.',relation:'Tramo resumido de la descendencia de Álvaro Velázquez hasta Isabel Novajas Velásquez.',source:'https://www.genealog.cl/Apellidos/Velazquez/'},
eugeniaBarros:{bio:'Eugenia Borgoño Vergara, hija del general José Manuel Borgoño y de María Mercedes Vergara Donoso, se casó el 15 de noviembre de 1843 con Manuel Barros Arana (Santiago, 1819), hermano del historiador Diego Barros Arana. Tuvieron cuatro hijos, entre ellos Martina y Luis Barros Borgoño; en su casa se reunía una tertulia de intelectuales.',relation:'Prima hermana de Pilar Amunátegui Borgoño, antepasada directa (sus padres eran hermanos).',source:'https://www.genealog.cl/Chile/B/Barros/#BarrosArana,Manuel'},
martinaBarros:{bio:'Martina Barros Borgoño (Santiago, 1850–1944) fue escritora y precursora del feminismo en Chile. Tras la muerte de su padre se crio en casa de su tío, el historiador Diego Barros Arana, a quien consideró su principal maestro. En 1872 publicó en La Revista de Santiago su traducción de The Subjection of Women de John Stuart Mill, “La esclavitud de la mujer”, con un prólogo polémico; desde entonces la igualdad de la mujer fue su causa. En 1874 se casó con el médico y escritor Augusto Orrego Luco. Su hermano Luis Barros Borgoño fue el rival de Arturo Alessandri en la elección presidencial de 1920. Escribió sus memorias, Recuerdos de mi vida.',relation:'Pariente de sangre colateral: nieta del general José Manuel Borgoño, hermano de Juana Borgoño Núñez, antepasada directa.',image:'https://thumb.wikimedia.org/wikipedia/commons/thumb/9/9a/Martina_Mercedes_Eugenia_Lucia_Barros_Borgo%C3%B1o.jpg/330px-Martina_Mercedes_Eugenia_Lucia_Barros_Borgo%C3%B1o.jpg',source:'https://es.wikipedia.org/wiki/Martina_Barros_Borgo%C3%B1o'},
diegoBarros:{bio:'Diego Barros Arana (Santiago, 1830–1907) fue pedagogo, diplomático e historiador, uno de los principales intelectuales liberales del siglo XIX. Su obra cumbre es la Historia General de Chile. Fue rector del Instituto Nacional y de la Universidad de Chile y legó su biblioteca al Estado.',relation:'Conexión indirecta: hermano de Manuel Barros Arana, esposo de Eugenia Borgoño; fue tío y tutor de Martina Barros Borgoño.',image:'https://thumb.wikimedia.org/wikipedia/commons/thumb/5/59/Obras_Diego_Barros_Arana_0015.jpg/330px-Obras_Diego_Barros_Arana_0015.jpg',source:'https://es.wikipedia.org/wiki/Diego_Barros_Arana'},
guillenCisternes:{bio:'Guillén de Cisternes (n. c. 1240), de la casa y solar de Cisternes en Francia, participó en el siglo XIII en la conquista del reino de Valencia junto al rey Jaime I de Aragón, el Conquistador, y fue señor del lugar y alquería de Cisternes y de Catot, en el condado de Cocentaina. En 1290 donó la mitad de la alquería de Cisternes a su hijo Ferrer.',relation:'Antepasado medieval probable de Pedro de Cisternas. Genealog.cl registra la sucesión Guillén → Ferrer (gobernador de Alcoy, 1330–1340) → Vidal (caballero, 1373) → Ferrer, pero el tramo hasta Mosén Miguel Guirao de Cisternas, padre del conquistador, figura “en construcción”; por eso el vínculo es provisional.',source:'https://www.genealog.cl/Apellidos/Cisternas/'},
cisternesAlcoy:{bio:'Ferrer de Cisternes recibió en 1290 la mitad de la alquería de Cisternes y fue gobernador y regidor del mero imperio de Alcoy hacia 1330–1340; casó con Bartholomena Rolf. Su hijo Vidal de Cisternes firmó como caballero en 1373 y en 1374 era gobernador de Alcoy; casó con Catalina Comiges. Le siguió Ferrer de Cisternes, “venerable caballero”, casado con Saurina Martí. Más tarde, Mosén Miguel Guirao de Cisternas (+ Planes, c. 1509), señor de Catamuruch en la baronía de Planes, casado con María Rotla, fue padre del conquistador Pedro de Cisternas.',relation:'Tramo provisional: la filiación exacta entre los Cisternes de Alcoy del siglo XIV y Mosén Miguel no está completa en la fuente.',source:'https://www.genealog.cl/Apellidos/Cisternas/'},
mirandaRueda:{bio:'Pedro de Miranda, conquistador de Chile, se casó con Esperanza de Rueda. Su hija Ana de Miranda y Rueda se casó en 1587, en la parroquia El Sagrario de Santiago, con el capitán Pedro de Cisternas Tobar, hijo del conquistador Pedro de Cisternas. Pedro de Miranda tuvo además un hijo natural mestizo, Jerónimo.',relation:'Antepasados directos por la línea Cisternas: padres de Ana de Miranda y Rueda.',source:'https://www.genealog.cl/Chile/M/Miranda/'},
jeronimoMiranda:{bio:'Jerónimo de Miranda, hijo natural mestizo del conquistador Pedro de Miranda y de una mujer indígena cuyo nombre no quedó registrado, era pastor en 1565. Se casó con Ana de las Hermanas, también mestiza (+ antes de 1589); su hijo Baltasar de Miranda (n. c. 1580) se casó con Micaela de Huerta, dueña de la estancia El Parral en Peumo.',relation:'Medio hermano de Ana de Miranda y Rueda, antepasada directa. Rama colateral: el linaje indígena de su madre no pasa a la línea directa.',source:'https://www.genealog.cl/Chile/M/Miranda/'},
carvajalAguirre:{bio:'José (Jusepe) de Carvajal Campofrío y Riberos, nacido en Santiago, sargento mayor avecindado en La Serena y de la casa de Roco, señores de Campofrío, recibió en 1635 mil cuadras en el valle de Camarquil. En 1615 se casó con Bernabela de Aguirre y Matienzo, hija de Hernando de Aguirre y Torres y nieta de Francisco de Aguirre. Su hija Mariana de Carvajal y Aguirre se casó en La Serena en 1635 con el vizcaíno Gabriel de Fuica y Arbieto y fue madre de Francisco de Fuica y Carvajal.',relation:'Antepasados directos por la línea Fuica–Cisternas. Bernabela era hermana de María de Aguirre y Matienzo, esposa de Pedro Pastene: así Francisco de Aguirre llega por un tercer camino a la línea del abuelo.',source:'https://www.genealog.cl/Chile/C/Carvajal/#CarvajalCampofrioRiberos,Jose'},
cacicaHuasco:{bio:'Aldonza Atuntalla fue cacica del Huasco, el valle del norte chico habitado por el pueblo diaguita. Según Genealog.cl, José de Carvajal Campofrío tuvo descendencia natural con ella; entre los hijos de José figura una María Roco de Carvajal “natural de Huasco”, aunque la fuente no indica expresamente quién era su madre.',relation:'Vínculo colateral: sus hijos con José de Carvajal serían medios hermanos de Mariana de Carvajal y Aguirre, antepasada directa. El linaje diaguita no pasa a la línea directa documentada.',source:'https://www.genealog.cl/Chile/C/Carvajal/#CarvajalCampofrioRiberos,Jose'},
hernandoAguirre:{bio:'Hernando de Aguirre y Torres (Talavera de la Reina, 1528 – La Serena, c. 1608), hijo de Francisco de Aguirre y María de Torres y Meneses, llegó a Chile en 1552. Fue lugarteniente de corregidor y varias veces corregidor de La Serena (1553, 1578, 1582 y 1599). En diciembre de 1578 defendió La Serena del corsario inglés Francis Drake y logró desalojarlo de la bahía de La Herradura. En 1566 fue apresado junto a su padre y a su cuñado Francisco de Godoy por soldados amotinados que invocaban órdenes de la Inquisición. Fue procurador del Cabildo de Santiago ante el Concilio de Lima (1573) y se casó en La Plata (Charcas) en 1567 con Agustina de Matienzo y Toro.',relation:'Antepasado directo por dos caminos: su hija María de Aguirre y Matienzo se casó con Pedro Pastene y Seixas, y su hija Bernabela con José de Carvajal Campofrío.',source:'https://www.genealog.cl/Apellidos/Aguirre/#AguirredelaRua,Francisco'},
cisternasPedro:{bio:'Pedro de Cisternas (Pere de Cisternes; Planes, Valencia, 1505 – Chile, c. 1590) pasó al Perú en 1535, asistió al socorro del Cuzco y a la expedición contra los chiriguanos y se unió a Pedro de Valdivia. Fue vecino fundador de Santiago (1541) y de La Serena (1544) y encomendero del Huasco. Se salvó de morir a manos de los indígenas pues se encontraba en su encomienda cuando aquellos destruyeron e incendiaron la naciente ciudad de La Serena, donde mataron a sus 14 pobladores y sus familias. Sin caballos, huyó a pie más de 300 km, caminando de noche y escondiéndose de día, hasta que lo encontraron en el valle de Aconcagua. En la refundación de 1549 fue uno de los ocho vecinos que recibieron solar; fue regidor perpetuo, tesorero, contador de la Real Hacienda y varias veces alcalde de La Serena. Se casó con María de Tobar. Según Wikipedia, de él descienden casi todos los Cisternas de Chile y fue de los primeros en traer parras a Chile.',relation:'Antepasado directo por dos caminos de la línea Vallejo: por su bisnieta Antonia de Cisternas Carrillo (rama Godoy–Carmona) y por su bisnieto Francisco de Cisternas y de la Fuente Villalobos (rama Mercado–Sierralta).',image:'https://thumb.wikimedia.org/wikipedia/commons/thumb/5/5f/Fundacion_de_Santiago.jpg/500px-Fundacion_de_Santiago.jpg',caption:'Fundación de Santiago (1541), de Pedro Lira; no es un retrato de Pedro de Cisternas · Wikimedia Commons',source:'https://www.genealog.cl/Apellidos/Cisternas/#Cisternas,Pedro'},
cisternasChain:{bio:'Pedro de Cisternas Tobar (La Serena, 1557), capitán y encomendero, se casó en 1587 con Ana de Miranda y Rueda. Su hijo Pedro de Cisternas Miranda (+ 1672), regidor perpetuo de La Serena y encomendero de Copiapó, se casó en 1612 con María de Carrillo y Escobar; fueron padres de Antonia de Cisternas Carrillo (esposa de Juan de Godoy y Alvarado) y de Juan de Cisternas Carrillo (Santiago, 1617 – Copiapó, 1703), alcalde de La Serena, capitán que llevó una compañía al Tucumán contra los calchaquíes en 1656 y gran estanciero de Copiapó.',relation:'Tramo resumido entre Pedro de Cisternas y sus dos líneas descendientes hacia los Vallejo.',source:'https://www.genealog.cl/Apellidos/Cisternas/#CisternasCarrilo,Juan'},
pasteneFuica:{bio:'Pedro Pastene y Seixas (Santiago, 1552), hijo de Juan Bautista Pastene, sirvió 30 años en la guerra de Arauco y fue alcalde de La Serena; se casó con María de Aguirre y Matienzo, hija de Hernando de Aguirre y Torres y nieta de Francisco de Aguirre. Su hijo Jerónimo Pastene y Aguirre (La Serena, 1601–1671) fue general y alcalde provincial perpetuo de La Serena; la hija de este, Isabel Pastene y Vega Sarmiento, se casó hacia 1659 con Francisco de Fuica y Carvajal, padres de María de Fuica y Pastene.',relation:'Juan Bautista Pastene, al centro del árbol, es antepasado de ambos abuelos: por este tramo la línea del abuelo desciende de él (como la de la abuela, por Francisco Pastene) y, por segunda vez, de Francisco de Aguirre.',source:'https://www.genealog.cl/Chile/P/Pastene/#PasteneSeixas,Pedro'},
cisternasFuica:{bio:'Francisco de Cisternas y de la Fuente Villalobos (+ La Serena, 1717), hijo de Juan de Cisternas Carrillo, fue maestre de campo, ocho veces corregidor de Copiapó, regidor de La Serena y dueño de las estancias de Carrizal, Chamonate, Chungungo, Punitaqui y Paposo, además de la viña y casa del gobernador Aguirre en Coquimbo. En 1685 se casó con María de Fuica y Pastene; tuvieron trece hijos, entre ellos Mariana y Rosa de Cisternas y Fuica.',relation:'Antepasados directos de la línea Vallejo. Su hija Rosa de Cisternas y Fuica se casó con Antonio de Jaraquemada Amasa y fue abuela de Paula Jaraquemada: por eso Paula es también pariente por el lado del abuelo.',source:'https://www.genealog.cl/Apellidos/Cisternas/#CisternasdelaFuenteVillalobos,Francisco'},
mercadoCisternas:{bio:'Felipe de Mercado y Villar (bautizado en San Julián, Castro Urdiales, 1702 – Copiapó, 1770) se casó sucesivamente con dos hermanas Cisternas y Fuica, María Josefa y Mariana (n. Copiapó, 1704). Hijas de Mariana fueron Felipa y Gregoria Mercado y Cisternas.',relation:'Antepasados directos: padres de Gregoria Mercado y Cisternas. Mariana era hermana de Rosa de Cisternas, abuela de Paula Jaraquemada.',source:'https://www.genealog.cl/Apellidos/Cisternas/#CisternasFuica,Mariana'},
sierraltaChain:{bio:'Gregoria Mercado y Cisternas, avecindada en Copiapó, se casó con su primo hermano Juan Bautista Sierralta Mercado (n. España c. 1729 – 1819). Su hijo José Antonio Sierralta Mercado se casó con Tadea Godoy; fueron padres de Francisca Sierralta Godoy, que se casó en Copiapó el 16 de abril de 1818 con José Félix Vallejo Ustáriz.',relation:'Tramo resumido entre los Mercado–Cisternas y Francisca Sierralta Godoy, bisabuela de Hernán Vallejo Burgoa.',source:'https://www.genealog.cl/Chile/S.html#SierraltaGodoy,Francisca'},
joseGregorio:{bio:'José Gregorio Amunátegui Muñoz (Chillán, 1801 – Santiago, 1853), hijo de Domingo de Amunátegui y Aldecoa, entró a la Academia Militar en 1817. Como teniente de artillería fue condecorado por la batalla de Maipú (1818), estuvo en el sitio de Talcahuano (1820), en la campaña de Chiloé y en Bellavista (enero de 1826). Pipiolo, fue dado de baja tras Lircay (1830) y se dedicó a la agricultura con su hermano José Domingo; volvió como subdirector de la Escuela Militar y teniente coronel en 1847. Se casó con Juana Borgoño Núñez, hija del aragonés Francisco Antonio Borgoño y Encuentros y de María del Carmen Núñez, y hermana del general José Manuel Borgoño.',relation:'Antepasados directos: padres de Pilar Amunátegui Borgoño, abuela de Julio Molina López.',source:'https://www.genealog.cl/Chile/A/Amunategui/#AmuateguiMunoz,JoseGregorio'},
joseDomingoAM:{bio:'José Domingo Amunátegui Muñoz (Chillán, 1798 – 1842) estudió en Chillán, Lima y Santiago, fue profesor de latín y filosofía en el Instituto Nacional, abogado desde 1826 y secretario del Senado (1828–1829). Pipiolo, combatió en Lircay (1830) y fue abogado defensor del general Ramón Freire, quien tras su muerte protegió a su familia. Se casó con Carmen Aldunate Irarrázaval.',relation:'Hermano de José Gregorio Amunátegui Muñoz (antepasado directo) y padre de los historiadores Miguel Luis y Gregorio Víctor Amunátegui Aldunate.',source:'https://www.genealog.cl/Chile/A/Amunategui/#AmunateguiMunoz,JoseDomingo'},
historians:{bio:'Miguel Luis Amunátegui Aldunate (Santiago, 1828–1888) fue historiador y político liberal: alumno de Andrés Bello, profesor del Instituto Nacional y de la Universidad de Chile, autor de La dictadura de O’Higgins y de los Títulos de la República de Chile a la soberanía de la extremidad austral del continente, fundador de la Sociedad de Instrucción Primaria (1856), diputado desde 1863 y ministro del Interior. Su hermano Gregorio Víctor Amunátegui Aldunate (Santiago, 1830–1899) fue filólogo, historiador, jurista y parlamentario liberal; escribieron juntos varias obras de historia chilena. Entre sus descendientes figura Domingo Amunátegui Solar, rector de la Universidad de Chile (1911–1922).',relation:'Primos hermanos de Pilar Amunátegui Borgoño, antepasada directa: sus padres, José Domingo y José Gregorio Amunátegui Muñoz, eran hermanos.',image:'https://upload.wikimedia.org/wikipedia/commons/0/01/Miguel_Luis_Amunategui_-_IN.jpg',caption:'Miguel Luis Amunátegui · Wikimedia Commons',source:'https://es.wikipedia.org/wiki/Miguel_Luis_Amun%C3%A1tegui'},
generalAB:{bio:'José Domingo Amunátegui Borgoño (Chillán, 1832 – Santiago, 1887) hizo carrera en el Ejército: estuvo en las campañas de la Araucanía (1861) y en Valparaíso durante el bombardeo español de 1866. En la Guerra del Pacífico sirvió en el Regimiento Chacabuco y combatió en Pisagua, Dolores, Tacna, Chorrillos y Miraflores; fue jefe de la expedición a Ica y estuvo en la ocupación del Callao. Fundó el Círculo Militar, dirigió la Academia de Guerra y alcanzó el grado de general en 1887.',relation:'Hermano de Pilar Amunátegui Borgoño, antepasada directa: tío bisabuelo de Julio Molina López.',image:'https://upload.wikimedia.org/wikipedia/commons/b/b7/Jos%C3%A9dgoamunategui.jpg',source:'https://es.wikipedia.org/wiki/Jos%C3%A9_Domingo_Amun%C3%A1tegui_Borgo%C3%B1o'},
borgonoGeneral:{bio:'José Manuel Borgoño Núñez (Petorca, 1792 – 1848) fue ingeniero militar y artillero de la Independencia: mandó la artillería en Rancagua (1814), sobrevivió en la clandestinidad durante la Reconquista, combatió en Cancha Rayada y Maipú y organizó la artillería de la Expedición Libertadora del Perú. General de brigada, luchó contra los hermanos Pincheira y, según Genealog.cl, fue vencedor de la resistencia realista en Chiloé. Fue dos veces ministro de Guerra y en 1838 viajó a España para negociar el tratado de paz y amistad que implicaba el reconocimiento de la independencia chilena. Murió siendo ministro, en 1848.',relation:'Hermano de Juana Borgoño Núñez, antepasada directa, y cuñado de José Gregorio Amunátegui Muñoz. Abuelo de la escritora Martina Barros Borgoño.',image:'https://thumb.wikimedia.org/wikipedia/commons/thumb/8/8e/Jos%C3%A9_Manuel_Borgo%C3%B1o_Monvoisin.jpg/330px-Jos%C3%A9_Manuel_Borgo%C3%B1o_Monvoisin.jpg',caption:'Retrato por Monvoisin · Wikimedia Commons',source:'https://es.wikipedia.org/wiki/Jos%C3%A9_Manuel_Borgo%C3%B1o'},
lopezGarcia:{bio:'Tomás López Borrego, hijo del gallego Tomás López Fernández, se casó en 1817 con Juana García Ortiz y Prieto, hija de Manuel García-Ortiz y María Guadalupe Prieto Romero. Entre sus hijos estuvieron Leonisa, Benjamín y Genaro López García Prieto.',relation:'Antepasados directos por dos caminos: Leonisa se casó con Juan Rafael Molina Varas y Benjamín con Pilar Amunátegui Borgoño; sus nietos Luis Antonio Molina López y Pilar López Amunátegui, primos hermanos, se casaron entre sí.',source:'https://www.genealog.cl/Chile/L/Lopez/#LopezBorrego,Tomas'},
benjamin:{bio:'Benjamín López García Prieto, hijo de Tomás López Borrego y Juana García Ortiz y Prieto, se casó con Pilar Amunátegui Borgoño; su hermano Genaro se casó con Mercedes, hermana de Pilar.',relation:'Antepasado directo: padre de Pilar López Amunátegui y hermano de Leonisa López, madre de Luis Antonio Molina López.',source:'https://www.genealog.cl/Chile/L/Lopez/#LopezGarciaPrieto,Benjamin'},
eastmanWeaver:{bio:'Thomas Eastman, tejedor de seda (weaver, silk weaver), y su esposa Ann vivían en Wentworth Street, en Spitalfields, el barrio londinense de los tejedores de seda. Entre 1766 y 1778 bautizaron en Christ Church Spitalfields a Hugh (1766), Mary (1768), Amelia (1771), Mary (1773), las mellizas Martha y Mary (1774), Thomas (10 de septiembre de 1775, con 11 días de nacido) y Mary (1778). La repetición del nombre Mary sugiere que varias hijas murieron pequeñas.',relation:'Padres provisionales de Thomas Eastman, el armador (no confundir a esta Ann, de apellido desconocido, con Anne White, esposa del armador). El blog familiar cita este mismo bautismo (con la nota de los 11 días) pero lo fecha en 1770; el libro transcrito dice 1775, un año coherente con los registros vecinos, mientras la lápida (74 años en 1844) sugiere 1769–1770. Falta confirmar que el niño bautizado en 1775 sea el mismo Thomas que emigró a Buenos Aires.',source:'https://www.freereg.org.uk/search_records/653bae0bf493fd60ce9df1fd/thomas-eastman-baptism-middlesex-spitalfields-1775-09-10'},
thomasEastman:{bio:'Thomas Eastman (Londres, bautizado en Christ Church Spitalfields el 10 de septiembre de 1775, con 11 días de nacido, según el libro parroquial; la tradición familiar y su lápida apuntan a 1770 – Buenos Aires, 2 de enero de 1844) se casó en 1793 en Leeds con Anne Elizabeth Mary White. Fue dueño y armador de la fragata inglesa George Canning, bautizada así por su amigo el estadista británico. Zarpó de Londres el 19 de enero de 1812 y llegó a Buenos Aires el 9 de marzo de 1812 tras 50 días de navegación. Entre sus pasajeros viajaban José de San Martín, Carlos María de Alvear y José Matías Zapiola, que venían a sumarse a la independencia sudamericana. Se estableció en Buenos Aires con su familia, fundó la casa comercial Eastman, Brinton y Cía., con sucursales en Río de Janeiro y Cantón, y fue suscriptor del primer cementerio protestante de la ciudad (1821). Sus hijos fueron John, Edmund (Edmund Holt), Thomas (muerto en Arequipa en 1837) y Sybella. Su lápida en Buenos Aires, “tributo de afecto filial”, lo recuerda como “nativo de Londres”, muerto el 2 de enero de 1844 a los 74 años, “recto y honorable en vida”, y cita a Hamlet: ni el temor a “the undiscovered country from whose bourn no traveller returns” quebró su ánimo. El libro de bautismos de Spitalfields lo registra como hijo de Thomas Eastman, tejedor de seda, y de Ann, de Wentworth Street. Geni, en cambio, da como padre a un George E. Eastman, sin fuente citada, y como esposa a Ann Berry Mathews.',relation:'Antepasados directos: Thomas Eastman y Anne White son los padres de Edmundo Eastman White, fundador de la rama chilena; de ellos viene el apellido Eastman White. La tradición familiar sitúa su boda en Londres; el blog de los descendientes, en St Peter, Leeds (7 de mayo de 1793).',image:'/genealog/thomas-eastman.jpg',caption:'Retrato atribuido · Geni',source:'http://eastmans2007.blogspot.com/2007/06/articulo-sobre-thomas-eastman-y-anne.html'},
tomasEQ:{bio:'Tomás Eastman Quiroga (Ovalle, 1841 – Valparaíso, 1890) se educó en Londres y se tituló de ingeniero civil. Como empresario y constructor de obras públicas levantó los Almacenes de la Aduana de Valparaíso, fue contratista de los ferrocarriles de Santiago a Valparaíso, de San Felipe a Los Andes (1872) y de San Fernando a Curicó, y construyó y reconstruyó el malecón de Valparaíso tras el temporal de 1870. Liberal, fue municipal de Valparaíso y primer alcalde del puerto; en marzo de 1881 le tocó recibir al ejército vencedor de la Guerra del Pacífico al mando de Baquedano. Después se dedicó a su hacienda de Limache, antes de José Tomás Urmeneta; desde 1884 hizo abovedar los antiguos canales de riego que cruzaban el barrio San Francisco, origen de los “túneles de Limache”. Fue diputado por Limache (1888–1891). Se casó en 1869 con Sofía Cox Bustillos y tuvo nueve hijos. Sus cartas a su hijo Tomás, estudiante en Manchester, son objeto de un estudio histórico sobre la oligarquía chilena.',relation:'Hermano de Edmundo Eastman Quiroga, antepasado directo (trastatarabuelo). Es abuelo de María Isabel Eastman Beeche y bisabuelo de Agustín Edwards Eastman, por lo que conecta la familia con los Edwards.',image:'https://thumb.wikimedia.org/wikipedia/commons/thumb/8/8b/Tom%C3%A1s_Eastman_Quiroga.jpg/330px-Tom%C3%A1s_Eastman_Quiroga.jpg',source:'https://es.wikipedia.org/wiki/Tom%C3%A1s_Eastman'},
eastmanWhite:{bio:'Edmundo Eastman White (Inglaterra, c. 1810 – Santiago, 1876), hijo de Thomas Eastman y Anne White, llegó niño a Buenos Aires con su familia y encabezó después la rama chilena. Se estableció en el norte chico de Chile y se casó con Tomasa Quiroga Darrigrande, hija de Juan Bautista Quiroga y Humeres y de María Antonia Darrigrande Marín. Tuvieron, entre otros, a Edmundo, Tomás, Adolfo, Carlos (intendente de Tarapacá), Isabel, Adela y Filia Eastman Quiroga.',relation:'Antepasados directos por la línea Eastman. Por Tomasa Quiroga Darrigrande se abre un tercer camino hacia la pareja Darrigrande–Mendibil.',source:'https://www.genealog.cl/Chile/E.html#EastmanWhite,Edmundo'},
edmundoEQ:{bio:'Edmundo Eastman Quiroga (Coquimbo, 1844 – Santiago, 1904), hijo de Edmundo Eastman White y Tomasa Quiroga, estudió en Londres y se dedicó a la agricultura y el comercio. Liberal, fue diputado por Ovalle entre 1885 y 1888. Se casó con Higinia Amenábar Cordovez. Fue padre de Elena, Luisa y Teresa Eastman Amenábar.',relation:'Antepasado directo: padre de Teresa Eastman Amenábar y abuelo de Edmundo Gana Eastman.',source:'https://www.genealog.cl/Chile/E.html#EastmanQuiroga,Edmundo'},
teresaEastman:{bio:'Teresa Eastman Amenábar, hija de Edmundo Eastman Quiroga e Higinia Amenábar Cordovez, se casó con Jorge Gana Gana. Fue madre de Edmundo, Jorge (general de aviación), Valentina, Jaime y Adolfo Gana Eastman.',relation:'Antepasada directa: bisabuela de la línea de María Cristina Gana Leay.',source:'https://www.genealog.cl/Chile/E.html#EastmanAmenabar,Teresa'},
edmundoManuel:{bio:'Edmundo Manuel Eastman Cox, hijo de Tomás Eastman Quiroga y Sofía Cox Bustillos, fue comerciante y socio de Wessel, Duval y Cía. Fue padre de María Isabel Eastman Beeche.',relation:'Primo hermano de Teresa Eastman Amenábar; abuelo de Agustín Edwards Eastman.'},
sofiaEastman:{bio:'Sofía Eastman Cox, Sofía Eastman de Huneeus (Valparaíso, 1873–1944), fue escritora y socialité. En 1915 fundó y presidió el Círculo de Lectura de Señoras, una de las primeras agrupaciones femeninas de Chile, dedicada a cultivar las letras y las artes y a mejorar la educación de las mujeres. Presidió la Cruz Roja de Mujeres de Chile (1918–1921) y publicó en diarios, revistas y antologías; se la sitúa en el “feminismo aristocrático” junto a Inés Echeverría Bello y Teresa Wilms Montt. Se casó en la Basílica de San Pedro con Roberto Huneeus Gana.',relation:'Hija de Tomás Eastman Quiroga y prima hermana de Teresa Eastman Amenábar, antepasada directa.',image:'https://thumb.wikimedia.org/wikipedia/commons/thumb/d/d1/Sof%C3%ADa_Eastman_de_Huneeus.jpg/330px-Sof%C3%ADa_Eastman_de_Huneeus.jpg',source:'https://es.wikipedia.org/wiki/Sof%C3%ADa_Eastman'},
mariaEastman:{bio:'María Isabel Eastman Beeche, hija de Edmundo Manuel Eastman Cox, se casó con Agustín Roberto Edwards Budge, presidente de El Mercurio y del Banco Edwards. Fue madre de Agustín Edwards Eastman y Roberto Edwards Eastman.',relation:'Nieta de Tomás Eastman Quiroga y prima segunda de Edmundo Gana Eastman.'},
sanchezMorales:{bio:'Juan Diego Sánchez de Morales (Marchena, Andalucía, 1514 – La Serena, 1576) pasó a Indias en 1534 y combatió en la defensa de Lima, el socorro del Cuzco y las campañas contra el Inca Manco. Como conquistador de Chile asistió a la fundación de Santiago y a la de La Serena, y acompañó a Francisco de Aguirre en su refundación de 1549. Fue regidor y alcalde de La Serena (1549–1561), encomendero del Huasco y dueño de viñas en el valle de Elqui, y aparece inmortalizado en La Araucana de Alonso de Ercilla. Se casó en Lima hacia 1545 con Inés de León y Carvajal.',relation:'Antepasado directo: su hija Isabel de Morales y León Carvajal se casó con Miguel Gómez de Silva y fue madre de María Gómez de Silva y Morales, esposa de Diego de Jaraquemada.',source:'https://www.genealog.cl/Apellidos/Morales/#SanchezdeMorales,Diego'},
quintrala:{bio:'Catalina de los Ríos y Lisperguer (Santiago, 1604 – 1665), la Quintrala, fue una aristócrata y terrateniente colonial, hija del general Gonzalo de los Ríos y Encío y de Catalina Lisperguer y Flores. Pelirroja, de ojos verdes y célebre por su belleza, fue acusada de envenenar a su padre y de crueldad con sus sirvientes e inquilinos; se le atribuyó incluso un pacto con el diablo. Su figura, muy mitificada a partir de las cartas del obispo Francisco de Salcedo, se volvió leyenda con Los Lisperguer y la Quintrala de Benjamín Vicuña Mackenna (1877) y la novela de Magdalena Petit. Su apodo vendría de “Catrala”, diminutivo de Catalina, o del quintral, planta de flores rojas.',relation:'Pariente colateral lejana, sin ascendencia en común con la familia: es nieta de Águeda Flores y bisnieta de doña Elvira de Talagante, y prima hermana de Juan Rodulfo Lisperguer y Solórzano, padre de María Antonia Catalina Lisperguer, esposa de Pedro Amasa Iturgoyen (hermano de Catalina Iturgoyen, antepasada directa).',image:'https://thumb.wikimedia.org/wikipedia/commons/thumb/8/8e/Catalina_by_Jaime_Abarca_F.jpg/330px-Catalina_by_Jaime_Abarca_F.jpg',caption:'Retrato imaginado por Jaime Abarca · Wikimedia Commons',source:'https://es.wikipedia.org/wiki/La_Quintrala'},
caciqueTalagante:{bio:'Tala Canta Ilabe fue el cacique o curaca del valle de Talagante al llegar los españoles. Según la tradición recogida en Wikipedia, gobernaba un mitimae, una colonia de población trasladada por el Imperio inca, y era de linaje inca, aunque el valle estaba habitado por picunches (mapuche del norte). Su familia se convirtió al cristianismo y el cacique dio nombre al lugar. Una de sus descendientes directas, bautizada como doña Elvira, se unió al carpintero y financista alemán Bartolomé Blumenthal (castellanizado Flores), compañero de Pedro de Valdivia, que recibió en 1549 la encomienda de los indígenas de Tala Canta Ilabe.',relation:'Conexión indirecta por matrimonio, no ascendencia directa: su descendiente María Antonia Catalina Lisperguer se casó en 1674 con Pedro Amasa Iturgoyen, hermano de Catalina Iturgoyen y Pastene, antepasada directa de la línea Gana. Los descendientes de esa pareja son primos lejanos de la familia.',source:'https://es.wikipedia.org/wiki/Elvira_de_Talagante'},
talaganteChain:{bio:'Doña Elvira de Talagante, hija o nieta del cacique según la fuente, tuvo con Bartolomé Flores a Águeda Flores (c. 1541–1632), heredera de tierras en Talagante, Quilicura, Peñalolén y el Maule. Águeda se casó con el alemán Pedro Lisperguer y fue madre de Juan Rodulfo Lisperguer y Flores (c. 1576–1616), capitán muerto en la batalla de Boroa; su nieta fue Catalina de los Ríos y Lisperguer, “la Quintrala”. Juan Rodulfo fue padre de Juan Rodulfo Lisperguer y Solórzano (n. 1615), maestre de campo general y corregidor de Santiago en 1648.',relation:'Tramo resumido del linaje del cacique de Talagante hasta María Antonia Catalina Lisperguer.',source:'https://www.genealog.cl/Chile/L/Lisperguer/'},
lisperguerIrarrazaval:{bio:'María Antonia Catalina de Lisperguer Irarrázaval (b. Santiago 1647 – 1727), hija de Juan Rodulfo Lisperguer y Solórzano y de Catalina Lorenza de Andía-Irarrázaval, se casó en la parroquia El Sagrario de Santiago a fines de 1674 con Pedro Amasa Iturgoyen. Sus hijas se casaron con las familias Ruiz de Azúa, Vázquez de Acuña y Rojas.',relation:'Descendiente del cacique de Talagante y cuñada de Catalina Iturgoyen y Pastene.',source:'https://www.genealog.cl/Apellidos/Yturgoyen/'},
pedroAmasa:{bio:'Pedro Amasa Iturgoyen Pastene (Santiago, 1638–1690) combatió en el Gran Alzamiento de 1655 y fue corregidor de Quillota, Concepción y Santiago, alcalde de Santiago en 1674, jefe de las fuerzas navales organizadas contra el pirata Bartolomé Sharp en 1681 y gobernador de Valparaíso entre 1685 y 1688.',relation:'Hermano de Catalina Iturgoyen y Pastene, antepasada directa; por su matrimonio con María Antonia Catalina Lisperguer, enlaza la familia con el linaje del cacique de Talagante.',source:'https://www.genealog.cl/Apellidos/Yturgoyen/'},
aguirre:{bio:'Francisco de Aguirre (Talavera de la Reina, 1508 – La Serena, c. 1581) fue militar, explorador y conquistador; antes de pasar a Indias combatió en la batalla de Pavía (1525). Era hijo de Hernando de la Rúa, contador de la Real Hacienda, y de Isabel Constanza de Meneses, y nieto de los hidalgos talaveranos García de la Rúa y Leonor Ramírez Álvarez de Herrera; su bisabuelo Hernán García de la Rúa nació hacia 1415. Llegó a Chile con Pedro de Valdivia y fue elegido alcalde del primer cabildo de Santiago en 1541. En 1549 refundó La Serena, destruida en el alzamiento indígena del norte. Como teniente de gobernador del Tucumán fundó en 1553 Santiago del Estero, la ciudad más antigua de Argentina, y más tarde gobernó el Tucumán en dos ocasiones. Tras la muerte de Valdivia disputó el gobierno de Chile. La Inquisición de Lima lo procesó dos veces y estuvo cinco años preso; entre las proposiciones que tuvo que abjurar figuraba que “se hace más servicio a Dios en hacer mestizos, que el pecado que con ello se hace”. Se casó con su prima hermana María de Torres y Meneses, y sus hijos, contando los naturales, habrían sido más de cincuenta. Murió en La Serena.',relation:'Antepasado directo por la línea Vallejo: su hija Isabel de Aguirre se casó con el conquistador Francisco de Godoy; su bisnieta Escolástica Godoy Cisternas fue madre de Ana Carmona Godoy, esposa de Diego Benjamín Vallejos y madre de José Luis Vallejo Carmona. Además, por su hijo Hernando de Aguirre y Torres llega por otros dos caminos: sus nietas María (esposa de Pedro Pastene y Seixas) y Bernabela (esposa de José de Carvajal Campofrío).',image:'https://thumb.wikimedia.org/wikipedia/commons/thumb/b/b0/Francisco_de_Aguirre_y_Meneses.jpg/330px-Francisco_de_Aguirre_y_Meneses.jpg',source:'https://www.genealog.cl/Chile/G/Godoy/#Godoy,Francisco'},
godoyChain:{bio:'Isabel de Aguirre y Torres, hija de Francisco de Aguirre, se casó con Francisco de Godoy (n. Medina del Campo), capitán y conquistador que llegó a Chile en 1557 con García Hurtado de Mendoza y fue alcalde de Valdivia. Su hijo Francisco de Godoy Aguirre, maestre de campo en La Serena, se casó con Agustina de Alvarado Cervantes. El hijo de ambos, Juan de Godoy y Alvarado, vecino de Mendoza y dueño de las estancias Rapel y Las Juntas, se casó en segundas nupcias con Antonia de Cisternas Carrillo. Su hija Escolástica Godoy Cisternas (+ c. 1723) se casó con el capitán Luis Carmona y fue madre de Ana Carmona Godoy.',relation:'Tramo resumido de la línea directa entre Francisco de Aguirre y Ana Carmona Godoy.',source:'https://www.genealog.cl/Chile/G/Godoy/#GodoyAlvarado,Juan'},
vallejoCarmona:{bio:'Diego Benjamín Vallejos Sánchez Morgado, hijo del sevillano Álvaro Miguel Vallejos (maestre de campo y corregidor de Copiapó en 1643), fue teniente de corregidor de Copiapó y testó allí en 1724. Se casó en la parroquia de La Serena el 13 de mayo de 1703 con Ana Carmona Godoy, hija del capitán Luis Carmona y de Escolástica Godoy Cisternas.',relation:'Pareja de antepasados directos; por Ana Carmona, la línea Vallejo sube hasta Francisco de Aguirre.',source:'https://www.genealog.cl/Chile/V/Vallejo/#VallejosSanchezMorgado,DiegoBenjamin'},
joseLuisVallejo:{bio:'José Luis Vallejo Carmona, hijo de Diego Benjamín Vallejos y Ana Carmona Godoy, fue fundador de la villa de Copiapó y alcalde en 1752.',relation:'Antepasado directo de la línea Vallejo.',source:'https://www.genealog.cl/Chile/V/Vallejo/#VallejoCarmona,JoseLuis'},
josefVal:{bio:'Gabriel Alejo Vallejo Hurtado de Mendoza fue alférez real de Copiapó y diputado en 1807.',relation:'Antepasado directo: padre de José Félix Vallejo Ustáriz y bisabuelo de Hernán Vallejo Burgoa.'},
paula:{bio:'Paula Jaraquemada Alquízar (Santiago, 1768–1851) fue una patriota de la Independencia. Tras la derrota de Cancha Rayada (1818) acogió al Ejército Patriota en su hacienda de Paine, donde los soldados se alimentaron y curaron, y aportó caballos, pertrechos e inquilinos a la campaña. Según la tradición, enfrentó a un oficial realista que le exigió las llaves de su bodega: se negó y expuso el pecho a las bayonetas antes que ceder. En sus últimos años se dedicó a obras de caridad y logró mejoras para la casa correccional de mujeres de Santiago.',relation:'Pariente sanguínea colateral: es nieta de Antonio de Jaraquemada Amasa, hermano de Antonia de Jaraquemada Amasa, antepasada directa por la línea Mendibil–Darrigrande–Gana. Es prima segunda de Rosa Darrigrande y Mendibil. Además, su cuñada Carmen Martínez Jaraquemada se casó con José Segundo Gana y Darrigrande. También es pariente por el lado del abuelo: su abuela Rosa de Cisternas y Fuica era hermana de Mariana de Cisternas y Fuica, antepasada de la línea Vallejo.',image:'https://thumb.wikimedia.org/wikipedia/commons/thumb/4/4e/Paula_Jaraquemada.jpg/330px-Paula_Jaraquemada.jpg',source:'https://www.genealog.cl/Chile/J/Jaraquemada/#JaraquemadaAlquizar,Paula'},
cid:{bio:'Rodrigo Díaz de Vivar, el Campeador (Vivar, c. 1048 – Valencia, 1099), fue un caballero castellano que sirvió a Sancho II y a Alfonso VI de Castilla, combatió también al servicio del rey taifa de Zaragoza y en 1094 conquistó Valencia, donde gobernó como señor independiente hasta su muerte. Su figura histórica y legendaria inspiró el Cantar de mio Cid, la gran epopeya de la literatura castellana. Se casó con Jimena Díaz; sus restos reposan hoy en la Catedral de Burgos.',relation:'Antepasado directo en la generación más antigua documentada del árbol. Genealog.cl marca a Antonia de Jaraquemada Amasa como descendiente de El Cid en 17 generaciones: El Cid → Cristina Rodríguez → García Ramírez, rey de Pamplona → Blanca de Navarra → Alfonso VIII de Castilla → Urraca de Castilla → Alfonso III de Portugal → … → Antonia.',image:'https://thumb.wikimedia.org/wikipedia/commons/thumb/4/45/Detalle_de_la_estatua_el_Cid_%28Parque_de_Balboa%29.jpg/330px-Detalle_de_la_estatua_el_Cid_%28Parque_de_Balboa%29.jpg',source:'https://www.genealog.cl/Chile/P/PoncedeLeon/#DiazelCampeador,Rodrigo'},
navarraCastilla:{bio:'Cristina Rodríguez, hija de El Cid, se casó hacia 1099 con el infante Ramiro Sánchez de Pamplona. Su hijo García Ramírez el Restaurador fue rey de Pamplona (1134–1150) y restauró la independencia del reino. La hija de García, Blanca de Navarra, se casó en 1151 con Sancho III de Castilla y fue madre de Alfonso VIII de Castilla, el vencedor de Las Navas de Tolosa (1212). Alfonso VIII se casó con Leonor Plantagenet, hija de Enrique II de Inglaterra y de Leonor de Aquitania. Su hija Urraca de Castilla se casó con Alfonso II de Portugal y fue madre de Alfonso III.',relation:'Tramo resumido de la línea directa entre El Cid y Alfonso III de Portugal. Por Leonor Plantagenet, la línea también desciende de Enrique II de Inglaterra y Leonor de Aquitania.',source:'https://www.genealog.cl/Apellidos/Navarra/#SanchezdePamplona,Ramiro'},
alfonsoIII:{bio:'Alfonso III de Portugal, el Boloñés o el Reformador (Coímbra, 1210 – 1279), fue rey de Portugal desde 1248, cuando sucedió a su hermano Sancho II. Era hijo de Alfonso II el Gordo y de Urraca de Castilla (hija de Alfonso VIII de Castilla), nieto de Sancho I y bisnieto de Alfonso I Enríquez, primer rey de Portugal. Completó la reconquista del Algarve.',relation:'Antepasado directo por la línea varonil Sousa–Silva: su hijo natural Alfonso Dionisio de Portugal (con María Peres de Enxara) inicia la rama que llega a Miguel Gómez de Silva, cuya nieta Antonia de Jaraquemada Amasa es antepasada de la línea Gana. Hay dos filiaciones naturales en la cadena; ambas están documentadas en la recopilación.',image:'https://thumb.wikimedia.org/wikipedia/commons/thumb/a/a0/D._Afonso_III_de_Portugal_-_The_Portuguese_Genealogy_%28Genealogia_dos_Reis_de_Portugal%29.png/330px-D._Afonso_III_de_Portugal_-_The_Portuguese_Genealogy_%28Genealogia_dos_Reis_de_Portugal%29.png',source:'https://www.genealog.cl/Apellidos/Sousa/#Portugal,AlfonsoDionisio'},
silvaChain:{bio:'Cadena publicada en Genealog.cl: Alfonso Dionisio de Portugal (1260–1310), hijo natural de Alfonso III → Rodrigo Alfonso de Sousa, ricohombre → Gonzalo Rodríguez de Sousa, hijo natural, señor de Zafra en Castilla → Diego López de Souza y Portocarrero, regidor de Toro → Pedro de Silva e Illescas, maestresala de Isabel la Católica → Juan de Silva y Fajardo, regidor perpetuo de Toro (casado con Ana de Merlo y Vivero) → Diego López de Silva y Merlo (n. Toro, 1517), caballero de Alcántara → Miguel Gómez de Silva (n. Ciudad Rodrigo, 1533), castellano de Arauco y alcalde de Santiago, casado con Isabel de Morales, hija del conquistador Diego Sánchez de Morales.',relation:'Tramo resumido de la línea directa entre Alfonso III y María Gómez de Silva y Morales. La propia ficha califica a Miguel Gómez de Silva como “VI° nieto varón en varón de Alfonso III”.',source:'https://www.genealog.cl/Apellidos/Gomez/#GomezdeSilva,Miguel'},
jaraGomez:{bio:'Diego de la Jaraquemada y Solórzano (Canarias, 1590 – Santiago, 1635) llegó a Chile en 1611 con su tío, el gobernador Juan de Jaraquemada. Fue regidor y corregidor de Santiago, teniente general de caballería, protector de indios y encomendero de Purapel. En 1615 se casó con María Gómez de Silva y Morales, hija de Miguel Gómez de Silva y de Isabel de Morales y León Carvajal.',relation:'Padres de Antonio de Jaraquemada y Silva Morales; por María, la línea directa sube a los reyes de Portugal.',source:'https://www.genealog.cl/Apellidos/Gomez/#GomezdeSilvaMorales,Maria'},
pasteneIturgoyen:{bio:'Francisco (Franciscano) Pastene y Seixas (1556–1628), hijo de Juan Bautista Pastene, fue abogado, alcalde y defensor general de indígenas. Su hija Lucía (Luisa) Pastene Justiniano (n. Santiago c. 1624) se casó hacia 1640 con Bernardo de Amasa Iturgoyen (1590–1660), maestre de campo, alcalde y corregidor de Santiago. Fueron padres de Catalina Iturgoyen y Pastene (n. 1641).',relation:'Tramo resumido de la línea directa entre Juan Bautista Pastene y Catalina Iturgoyen y Pastene, esposa de Antonio de Jaraquemada.',source:'https://www.genealog.cl/Apellidos/Yturgoyen/#AmasaIturgoyenPastene,Catalina'},
antonioJaraSilva:{bio:'Antonio de Jaraquemada y Silva Morales (Santiago, 1626–1688) fue encomendero de Purapel y capitán de caballería. Participó en la defensa del Reino durante el alzamiento indígena de 1655, fue teniente general de caballería y alcalde de Santiago en 1657. Era hijo de Diego de Jaraquemada y Solórzano y de María Gómez de Silva y Morales, y se casó con Catalina Iturgoyen y Pastene.',relation:'Antepasado directo: por él la línea sube a los Jaraquemada de Canarias y a los conquistadores Gómez de Silva y Sánchez de Morales.',source:'https://www.genealog.cl/Chile/J/Jaraquemada/#JaraquemadaSilvaMorales,Antonio'},
catalinaIturgoyen:{bio:'Catalina Iturgoyen y Pastene (Santiago, 1641) era hija de Bernardo de Amasa Iturgoyen y de Lucía Pastene Justiniano, y bisnieta del navegante Juan Bautista Pastene. Su hermano Pedro Amasa Iturgoyen fue gobernador de Valparaíso. Se casó con Antonio de Jaraquemada y Silva Morales.',relation:'Antepasada directa: por ella la línea de la abuela remonta a Juan Bautista Pastene.',source:'https://www.genealog.cl/Apellidos/Yturgoyen/#AmasaIturgoyenPastene,Catalina'},

antoniaJara:{bio:'Antonia de Jaraquemada Amasa nació en Santiago hacia 1706. Tuvo descendencia natural con el vizcaíno Tomás de Mendibil, entre ella María del Carmen Mendibil y Jaraquemada.',relation:'Antepasada directa de la línea Gana y hermana de Antonio de Jaraquemada Amasa, abuelo de Paula Jaraquemada.',source:'https://www.genealog.cl/Chile/J/Jaraquemada/#JaraquemadaAmasa,Antonia'},
antonioJaraAmasa:{bio:'Antonio de Jaraquemada Amasa (n. Santiago, 1684) fue capitán de caballería, comandante del Batallón de Milicias desde 1707 y teniente general de caballería. Se casó en Copiapó en 1721 con Rosa de Cisternas y Fuica y testó en 1742.',relation:'Hermano de Antonia de Jaraquemada Amasa y abuelo de Paula Jaraquemada.',source:'https://www.genealog.cl/Chile/J/Jaraquemada/#JaraquemadaAmasa,Antonio'},
domingoJara:{bio:'Domingo de Jaraquemada Cisternas, nacido en Santiago, fue capitán de caballería, maestre de campo y regidor del Cabildo de Santiago. De su segundo matrimonio, en 1752, con Cecilia Alquízar y Herrera Guzmán, nacieron Paula, Nicolasa, Mercedes y Diego Jaraquemada Alquízar.',relation:'Padre de Paula Jaraquemada y primo hermano de María del Carmen Mendibil y Jaraquemada.',source:'https://www.genealog.cl/Chile/J/Jaraquemada/#JaraquemadaCisternas,Domingo'},
concepcionJara:{bio:'María de la Concepción de Jaraquemada Cisternas se casó con José Martínez de la Torre, natural de la Villa de Canales, Logroño. Fueron padres de Francisco y Carmen Martínez Jaraquemada.',relation:'Hermana de Domingo de Jaraquemada Cisternas; suegra de Paula Jaraquemada y de José Segundo Gana y Darrigrande.',source:'https://www.genealog.cl/Chile/J/Jaraquemada/#JaraquemadaCisternas,MariaConcepcion'},
mendibil:{bio:'María del Carmen Mendibil y Jaraquemada, santiaguina, figura como hija natural de Tomás de Mendibil y Antonia de Jaraquemada Amasa. Se casó con Juan Daniel Darrigrande y García Iribarren en la parroquia El Sagrario de Santiago el 12 de septiembre de 1717 y testó en 1768.',relation:'Antepasada directa: madre de Rosa Darrigrande y Mendibil.'},
rosaD:{bio:'Rosa Darrigrande y Mendibil se casó con José Francisco de Gana y Amézaga en la parroquia El Sagrario de Santiago el 23 de febrero de 1761. Fue madre de Agustín Domingo Gana y Darrigrande y de José Segundo Gana y Darrigrande.',relation:'Antepasada directa de la línea Gana; por su madre desciende de los Jaraquemada y de Juan Bautista Pastene.'},
franciscoMartinez:{bio:'Francisco Martínez Jaraquemada fue hijo de José Martínez de la Torre y María Concepción de Jaraquemada Cisternas. Se casó con su prima hermana Paula Jaraquemada Alquízar.',relation:'Esposo de Paula Jaraquemada y hermano de Carmen Martínez Jaraquemada, esposa de José Segundo Gana.'},
joseSegundoGana:{bio:'José Segundo Gana y Darrigrande fue hijo de José Francisco de Gana y Amézaga y Rosa Darrigrande y Mendibil. Se casó con Carmen Martínez Jaraquemada, cuñada de Paula Jaraquemada.',relation:'Hermano de Agustín Domingo Gana; rama colateral que enlaza por matrimonio a los Gana con los Martínez Jaraquemada.'},
juanPastene:{bio:'Navegante y explorador genovés al servicio de la Corona española. Participó en las primeras exploraciones de la costa del Pacífico sur, ejerció cargos militares y municipales en Santiago y es tradicionalmente reconocido como fundador de Valparaíso.',relation:'Antepasado directo por los dos abuelos. Por la abuela: su hijo Francisco Pastene y Seixas fue padre de Lucía Pastene Justiniano, madre de Catalina Iturgoyen y Pastene, esposa de Antonio de Jaraquemada. De ellos desciende Antonia de Jaraquemada Amasa y, por Mendibil y Darrigrande, la línea Gana. Por el abuelo: su hijo Pedro Pastene y Seixas es antepasado de María de Fuica y Pastene y, por los Cisternas, Mercado y Sierralta, de la línea Vallejo.',image:'https://thumb.wikimedia.org/wikipedia/commons/thumb/4/4f/Juan_Bautista_Pastene.jpg/330px-Juan_Bautista_Pastene.jpg',source:'https://es.wikipedia.org/wiki/Juan_Bautista_Pastene'},
vicente:{bio:'Vicente García-Huidobro Fernández (1893–1948) fue poeta, ensayista y fundador del creacionismo. Su red familiar se conecta con este árbol por Mercedes García-Huidobro, hermana de Vicente y esposa de Diego Dublé Urrutia.',relation:'Conexión matrimonial colateral; no es antepasado sanguíneo probado.',image:'https://thumb.wikimedia.org/wikipedia/commons/thumb/6/61/Vicente_huidobro.jpg/330px-Vicente_huidobro.jpg',source:'https://es.wikipedia.org/wiki/Vicente_Huidobro'},
grove:{bio:'José Marmaduke Grove Vallejo (1878–1954) fue militar, aviador y político. Participó en la organización de la aviación militar chilena y fue una figura relevante del socialismo y de la República Socialista de 1932.',relation:'Conexión matrimonial mediante Ana Vallejo Burgoa, hermana de Hernán Vallejo Burgoa.',image:'https://thumb.wikimedia.org/wikipedia/commons/thumb/b/b1/Cdte._Marmaduke_Grove_.jpg/330px-Cdte._Marmaduke_Grove_.jpg',source:'https://es.wikipedia.org/wiki/Marmaduke_Grove'},
blanco:{bio:'Manuel Blanco Encalada (1790–1876) fue marino, almirante y político. Fue el primer Presidente de Chile y participó en las campañas de Independencia y en la organización de la escuadra chilena.',relation:'Conexión matrimonial mediante María del Carmen Gana y López.',image:'https://thumb.wikimedia.org/wikipedia/commons/thumb/9/9e/M._Blanco_Encalada.jpg/330px-M._Blanco_Encalada.jpg',source:'https://es.wikipedia.org/wiki/Manuel_Blanco_Encalada'},
allende:{bio:'Salvador Allende Gossens (1908–1973) fue médico, dirigente socialista y Presidente de Chile entre 1970 y 1973. Su trayectoria política marcó profundamente la historia chilena del siglo XX.',relation:'Conexión matrimonial colateral a través de la rama Vallejo–Corbalán Allende.',image:'https://upload.wikimedia.org/wikipedia/commons/0/0d/Salvador_Allende_Gossens-.jpg',source:'https://es.wikipedia.org/wiki/Salvador_Allende'},
blest:{bio:'Alberto Blest Gana (1830–1920) fue novelista, diplomático e intendente de Colchagua. Es considerado una figura fundacional de la novela chilena y escribió Martín Rivas, entre otras obras.',relation:'Conexión sanguínea colateral por María de la Luz Gana y López.',image:'https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c5/Alberto_Blest_Gana.jpeg/330px-Alberto_Blest_Gana.jpeg',source:'https://es.wikipedia.org/wiki/Alberto_Blest_Gana'},
diegoAlmeyda:{bio:'Diego Dublé Almeyda (1841–1922) fue militar y diplomático chileno. Participó en la Guerra del Pacífico y ocupó cargos militares y de representación; en esta red es hermano de Fresia Dublé Almeida.',relation:'Hermano de Fresia Dublé Almeida e hijo de Diego Nicasio Dublé Astorga.',image:'https://upload.wikimedia.org/wikipedia/commons/a/a7/Diego_Duble_Almeyda_-_FP.jpg',source:'https://es.wikipedia.org/wiki/Diego_Dublé_Almeyda'},
baldomero:{bio:'Baldomero Dublé Almeyda (1843–1881) fue militar chileno de la Guerra del Pacífico. Murió en la batalla de Chorrillos y recibió póstumamente los grados de coronel y otros honores militares.',relation:'Hermano de Fresia y Diego Dublé Almeyda; tío de Diego Dublé Urrutia.',image:'https://upload.wikimedia.org/wikipedia/commons/1/1e/Baldomero_y_Diego_Dubl%C3%A9_Almeyda_y_el_comandante_Ricardo_Santa_Cruz%2C_junto_al_proveedor_del_Ej%C3%A9rcito.jpg',source:'https://es.wikipedia.org/wiki/Baldomero_Dublé_Almeyda'},
diegoU:{bio:'Diego Dublé Urrutia (1877–1967) fue poeta, escritor, diplomático y Premio Nacional de Literatura de 1958. Su obra incluye poemas vinculados a la experiencia de la Guerra del Pacífico.',relation:'Descendiente de la rama Dublé y cuñado de Vicente Huidobro.',image:'https://thumb.wikimedia.org/wikipedia/commons/thumb/7/73/D._Duble_Urrutia.JPG/330px-D._Duble_Urrutia.JPG',source:'https://es.wikipedia.org/wiki/Diego_Dublé_Urrutia'},
agustinCarlos:{bio:'Agustín Carlos Edwards Mac-Clure (c. 1878–1941) fue empresario periodístico, economista, banquero, diplomático y político. Fundó El Mercurio de Santiago y otros diarios, fue ministro y embajador, y presidió la Asamblea de la Liga de las Naciones en 1922.',relation:'Suegro de Agustín Roberto Edwards Budge; conexión matrimonial con la rama Eastman.',image:'https://upload.wikimedia.org/wikipedia/commons/e/e3/AEdwardMC.jpg',source:'https://es.wikipedia.org/wiki/Agustín_Edwards_Mac-Clure'},
agustinEastman:{bio:'Agustín Edwards Eastman (1927–2017) fue periodista y director de El Mercurio de Santiago durante décadas. También presidió la Empresa El Mercurio y fue una de las figuras más influyentes de la prensa chilena contemporánea.',relation:'Descendiente de la unión Eastman–Edwards; conexión colateral con la rama Gana–Eastman.',image:'https://thumb.wikimedia.org/wikipedia/commons/thumb/4/4e/15-01-14-Agust%C3%ADn_Edwards_Eastman.jpg/330px-15-01-14-Agust%C3%ADn_Edwards_Eastman.jpg',source:'https://es.wikipedia.org/wiki/Agustín_Edwards_Eastman'},
arturoPrat:{bio:'Arturo Prat Chacón (1848–1879) fue comandante de la corbeta Esmeralda y murió durante el combate naval de Iquique, convirtiéndose en uno de los principales héroes navales de Chile.',relation:'Conexión matrimonial: Carlos Prat Echaurren, casado con María Luz Gana Subercaseaux, era su nieto.',image:'https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c9/Arturo_Prat_con_espada.jpg/330px-Arturo_Prat_con_espada.jpg',source:'https://es.wikipedia.org/wiki/Arturo_Prat'},
mariaLuzPrat:{bio:'María Luz Gana Subercaseaux pertenece a una rama colateral descendiente de Federico Gana Gana. Su matrimonio con Carlos Prat Echaurren enlaza la red Gana con la familia del héroe naval Arturo Prat.',relation:'Descendiente colateral de Federico Gana y vínculo matrimonial con la familia Prat.'},
carlosPrat:{bio:'Carlos Prat Echaurren pertenece a la familia Prat y fue nieto de Arturo Prat Chacón. Su matrimonio con María Luz Gana Subercaseaux establece la conexión entre ambas familias.',relation:'Esposo de María Luz Gana Subercaseaux y nieto de Arturo Prat Chacón.'},
anibalPinto:{bio:'Aníbal Pinto Garmendia (1825–1884) fue abogado, intendente de Concepción, ministro de Guerra y Marina y Presidente de Chile entre 1876 y 1881. Durante su gobierno comenzó la Guerra del Pacífico.',relation:'Conexión por matrimonio y red Zañartu: su esposa Delfina era hija de Josefa Zañartu; Pedro Zañartu se casó en segundas nupcias con María del Tránsito, hermana de Gertrudis, esposa de Ignacio Gana y López.',image:'https://thumb.wikimedia.org/wikipedia/commons/thumb/d/d6/Anibal_Pinto_3.jpg/330px-Anibal_Pinto_3.jpg',source:'https://es.wikipedia.org/wiki/Aníbal_Pinto'},
delfinaCruz:{bio:'Delfina Cruz Zañartu fue hija de José María de la Cruz Prieto y Josefa Zañartu Trujillo. Se casó con Aníbal Pinto Garmendia alrededor de 1851.',relation:'Esposa de Aníbal Pinto y descendiente de la rama Zañartu conectada por matrimonio con los Gana.'},
ignacioGana:{bio:'Ignacio Gana y López, hermano de Agustín Gana y López, fue diputado en 1829. Su matrimonio con Gertrudis Zañartu y Arrau abre la conexión indirecta con Aníbal Pinto.',relation:'Hermano de Agustín Gana y esposo de Gertrudis Zañartu y Arrau.'},
inesAllende:{bio:'Inés Allende Gossens fue hermana de Salvador Allende Gossens. Se casó con Eduardo Grove Vallejo, hijo de José Marmaduke Grove Avalos y Ana Vallejo Burgoa.',relation:'Hermana de Salvador Allende y esposa de Eduardo Grove Vallejo; conexión indirecta con la rama Vallejo–Grove.'},
eduardoGrove:{bio:'Eduardo Grove Vallejo fue hijo de José Marmaduke Grove Avalos y Ana Vallejo Burgoa. Su matrimonio con Inés Allende Gossens enlaza la rama Vallejo–Grove con la familia Allende.',relation:'Hijo de Ana Vallejo Burgoa y José Marmaduke Grove; esposo de Inés Allende Gossens.'},
maryRoseMacGill:{bio:'Mary Rose Mac-Gill Herrera (n. 1933) fue presidenta de la Corporación de Amigos del Teatro Municipal. En esta red se incorpora por su matrimonio con Julio Bernardo Subercaseaux Barros.',relation:'Conexión matrimonial colateral: su primer esposo, Julio Bernardo Subercaseaux Barros, desciende del mismo tronco Subercaseaux que Blanca Subercaseaux del Río, esposa de Federico Gana Gana.',image:'https://www.genealog.cl/Chile/M/MacGill/MacGillHerrera,MaryRose-www.genealogiachilenaenred.cl.jpg',source:'https://www.genealog.cl/Chile/M.html#MacGillHerrera,MaryRose'},
julioBernardoSub:{bio:'Julio Bernardo Subercaseaux Barros (1926–2012) fue abogado, diputado, ministro, intendente de Santiago, ministro de Minería, embajador en Turquía y senador. Fue el primer esposo de Mary Rose Mac-Gill Herrera.',relation:'Descendiente de Ramón Subercaseaux Mercado y del tronco Subercaseaux común con la rama de Blanca Subercaseaux del Río.'},
blancaSubRio:{bio:'Blanca Subercaseaux del Río fue hija de Francisco Subercaseaux de la Torre e Isolina del Río Racet. Se casó con Federico Gana Gana y fue madre de María Luz Gana Subercaseaux.',relation:'Esposa de Federico Gana Gana; su rama Subercaseaux enlaza indirectamente con Julio Bernardo Subercaseaux Barros.'},
molinaRiquelme:{bio:'Padres de Agustín Molina Riquelme según su partida de matrimonio (Matriz del Salvador, Valparaíso, 10 de julio de 1758). El acta dice que Agustín es hijo de “JI Molina” y Rita Riquelme, del Partido del Maule; el índice de FamilySearch lo transcribió como “Julio”, pero “J. I.” es la abreviatura habitual de Juan Ignacio, nombre que también da una recopilación genealógica (MOLV01). Esa recopilación agrega que Juan Ignacio nació en 1703 en la hacienda Huaraculén, lo que lo acercaría a la familia del Abate Molina (los Molina de Concepción y Chiloé), pero ese dato no está respaldado por un registro.',relation:'Antepasados directos más antiguos documentados de la línea Molina: padres de Agustín Molina Riquelme.',source:'https://www.familysearch.org/ark:/61903/1:1:68TC-D5JS'},
bocanegraSoto:{bio:'Antonio Bocanegra Figueroa se casó el 15 de enero de 1723 con Juana Soto Vera; Genealog.cl sitúa el matrimonio en Valparaíso. El índice de esa partida nombra a los padres de ambos: Juan Bocanegra y Pascuala Figueroa, y Miguel Soto y Catalina Vera. Tuvieron al menos a Marta (nacida en El Almendral de Valparaíso), Francisco, Fernando (casado en 1763 en El Sagrario de Santiago con María del Carmen Amaro Castillo) y María Josefa (casada en 1755 con Bartolomé Sánchez Muñoz).',relation:'Antepasados directos: padres de Marta Bocanegra Soto, esposa de Agustín Molina Riquelme y madre de José Molina Bocanegra.',source:'https://www.familysearch.org/ark:/61903/1:1:665F-2WXZ'},
bocanegraFigueroa:{bio:'Juan Bocanegra y Pascuala Figueroa aparecen como padres de Antonio Bocanegra Figueroa en su partida de matrimonio de 1723. Una Luisa Bocanegra Figueroa, casada en Renca el 10 de abril de 1696 con Gabriel Henríquez Zegarra, sería hija de ellos. Un Juan Bocanegra figura también como padre de un Francisco Bocanegra en matrimonios de 1705 y 1712.',relation:'Antepasados directos: abuelos paternos de Marta Bocanegra Soto.',source:'https://www.familysearch.org/ark:/61903/1:1:665F-2WXZ'},
sotoVera:{bio:'Miguel de Soto y Catalina Vera aparecen como padres de Juana Soto Vera en su partida de matrimonio de 1723. El árbol colaborativo de FamilySearch les da fechas (Miguel c. 1675–1740, Catalina Vera Muxica c. 1680–1750), pero sin registros que las respalden.',relation:'Antepasados directos: abuelos maternos de Marta Bocanegra Soto.',source:'https://www.familysearch.org/ark:/61903/1:1:665F-2WXZ'},
huaynaCapac:{bio:'Huayna Cápac (c. 1468–1527) fue el undécimo Sapa Inca. Con su esposa secundaria Añas Colque, curaca de Hurinhuaylas, tuvo diez hijos documentados en una probanza de nobleza de 1572, bajo el gobierno del virrey Francisco de Toledo. Entre ellos figura Beatriz Huaylas Capac Colla.',relation:'Vínculo provisional: solo llega al árbol si se confirma la cadena colonial (Bazán–Sánchez de Salazar–Bocanegra) que lo conecta con Antonio de Bocanegra. Esa cadena, hoy, solo aparece en el árbol colaborativo de FamilySearch, sin fuentes.',source:'https://es.wikipedia.org/wiki/A%C3%B1as_Colque'},
beatrizHuaylas:{bio:'Beatriz Huaylas Capac Colla, hija de Huayna Cápac y Añas Colque, se casó con Pedro de Bazán y Bustinza. Tuvieron a Mariana y Pedro de Bazán Bustinza y Capac, documentados en la misma probanza de 1572. Este tramo (Huayna Cápac–Añas Colque–Beatriz Huaylas–Bazán y Bustinza) está respaldado por una fuente académica citable, a diferencia del resto de la cadena hacia abajo.',relation:'Vínculo provisional: antepasada documentada por su lado, pero la conexión hacia Antonio de Bocanegra (más abajo) no tiene fuente.',source:'https://es.wikipedia.org/wiki/A%C3%B1as_Colque'},
bazanBocanegraChain:{bio:'Tramo tomado de una captura del árbol colaborativo de FamilySearch (Árbol Familiar, sin fuentes visibles): de Pedro/Mariana de Bazán Bustinza y Capac baja a un matrimonio Bustinza–Bazán, luego a Juan de Silva con Mariana de Bazán, luego a Antonio [Esteban] Sánchez Olaiz con Feliciana de Salazar (en paralelo, Gerónimo Carrillo con María González), hasta llegar a Antonio de Bocanegra [Olaizola y Salazar] con María de Mendoza. Genealog.cl sí registra a Antonio de Bocanegra Olaizola y Salazar casado con María de Mendoza, y también a un "Antonio Esteban Sánchez Olaiz" y una "Feliciana de Salazar" cerca de esa familia, pero ningún registro muestra el matrimonio ni la filiación exactos que unen a estas personas entre sí ni con Esteban de Bocanegra (el padre de Juan Antonio, más abajo).',relation:'Cadena provisional, no verificada: pendiente de una fuente (partida de matrimonio o bautismo) que confirme cada eslabón, empezando por el que la conecta con Esteban de Bocanegra.'},
juanAndresUztariz:{bio:'Juan Andrés de Ustáriz Vertizberea (Narvarte, Navarra, 31 de marzo de 1656 – Santiago, 19 de mayo de 1718) fue comerciante, Caballero de la Orden de Santiago y Gobernador de Chile entre el 27 de enero de 1709 y el 23 de diciembre de 1716, cuando fue destituido por corrupción tras un juicio de residencia. Era hijo de Juan de Uztáriz Echeandía y Magdalena de Vertizberea y Videgui. Se casó con María Francisca de Hoyos y Salinas de Valdez, de Sevilla.',relation:'Antepasado directo: por su hijo Martín José de Ustáriz llega hasta José Félix Vallejo Ustáriz.',source:'https://es.wikipedia.org/wiki/Juan_Andr%C3%A9s_de_Ust%C3%A1riz'},
ustarizHoyosSilva:{bio:'Martín José de Ustáriz y Hoyos, hijo del gobernador Juan Andrés de Ustáriz, fue Corregidor de Copiapó (1759–1762) y se casó con Catalina de Silva. Su hijo Andrés de Ustáriz y Silva se casó con María del Carmen Álvarez de Tobar y Rojas (n. Copiapó, 1727; hija de Diego Álvarez de Tobar y Varas Bernal y Manuela de Rojas Bascuñán).',relation:'Antepasados directos: bisabuelos de María de la Trinidad Ustáriz y Álvarez de Tobar.',source:'https://www.genealog.cl/Chile/U.html'},
ustarizAlvarezTobar:{bio:'María de la Trinidad Ustáriz y Álvarez de Tobar se casó con Gabriel Alejo Vallejo Hurtado de Mendoza, alférez real de Copiapó y diputado en 1807. Genealog.cl (Familias chilenas, de Guillermo de la Cuadra Gormaz) documenta toda esta línea Ustáriz hasta el gobernador Juan Andrés de Ustáriz.',relation:'Antepasada directa: madre de José Félix Vallejo Ustáriz.',source:'https://www.genealog.cl/Chile/V/Vallejo/#VallejoUstariz,JoseFelix'},
bocanegraAlvarado:{bio:'Juan Antonio Bocanegra Alvarado, “blanco”, fue bautizado el 29 de agosto de 1647 en El Sagrario de Santiago, hijo de Esteban Bocanegra y María Alvarado; así lo registra el índice de la partida. La misma pareja bautizó a una hija, María Bocanegra Alvarado, el 26 de junio de 1644 en la misma parroquia. El árbol colaborativo de FamilySearch lo identifica con Juan Bocanegra, marido de Pascuala Figueroa y padre de Antonio Bocanegra Figueroa. Las fechas calzan, porque sus hijos se casaron en 1696 y 1723, y “Juan” es la forma abreviada habitual de “Juan Antonio”. Desde ahí el árbol colaborativo sube a Antonio de Bocanegra y María de Mendoza, y a Esteban Sánchez Olaisola, a quienes Genealog.cl sí registra. Una hija de Antonio y María de Mendoza, Josefa de Bocanegra y Mendoza, se casó en Santiago en 1645 con Pedro de Ribera Homem de Pessoa. Falta un registro que pruebe que el bautizado en 1647 es el mismo Juan, y otro que pruebe que Esteban es hijo de Antonio de Bocanegra.',relation:'Provisional: padres documentados de Juan Antonio Bocanegra Alvarado, que muy probablemente es el Juan Bocanegra padre de Antonio. Esa identificación todavía no está probada.',source:'https://www.familysearch.org/ark:/61903/1:1:FJFW-7G9'},
agustinM:{bio:'Agustín Molina Riquelme (n. 1735) fue vecino y propietario. Genealog.cl lo registra como dueño de un sitio en El Almendral de Valparaíso y de propiedades en Valdivia, en la calle del Peligro. Se casó el 10 de julio de 1758 en la Matriz del Salvador de Valparaíso con Marta Bocanegra Soto, hija de Antonio Bocanegra Figueroa y Juana Soto Vera.',relation:'Antepasado directo: padre de José Molina Bocanegra. Su partida de matrimonio (Matriz del Salvador, Valparaíso, 10 de julio de 1758) lo registra como hijo de “JI Molina” (probablemente Juan Ignacio) y Rita Riquelme, del Partido del Maule. No hay relación demostrada con el Abate Juan Ignacio Molina.',source:'https://www.familysearch.org/ark:/61903/1:1:68TC-D5JS'},
juanr:{bio:'Juan Rafael Molina Varas (1822–1891) fue agente de Aduanas y tuvo una oficina en la calle Prat de Valparaíso.',relation:'Antepasado directo de Luis Antonio Molina López.'},
agustinGanaLopez:{bio:'Agustín Gana y López (1802–1884) fue militar. Combatió en Maipú, participó en la captura de la fragata María Isabel, sirvió en el Ejército Libertador del Perú y participó en las campañas de Chiloé y contra los Pincheira. Alcanzó el grado de teniente coronel y fue edecán del Presidente de la República.',relation:'Antepasado directo: padre de Carolina Gana Cruz, que se casó con su primo Enrique Gana Munizaga y fue madre de Jorge Gana Gana. Hermano de Manuel Segundo, María del Carmen e Ignacio Gana.'},
fedGanaMunizaga:{bio:'Federico Gana Munizaga fue hijo de Manuel Segundo Gana y López, y por tanto hermano de Enrique Gana Munizaga. Se casó con su prima hermana Rosario Gana Castro; según Wikipedia, ambos eran primos hermanos entre sí y descendientes de Alberto Blest Gana.',relation:'Rama colateral Gana: hermano de Enrique Gana Munizaga y padre de Federico Gana Gana.'},
federico:{bio:'Federico Gana Gana (1867–1926) fue abogado y escritor. Hijo mayor de Federico Gana Munizaga y Rosario Gana Castro, primos hermanos entre sí. Escribió cuentos de ambiente campesino como Días de campo y Manchas de color.',relation:'Rama colateral Gana: sobrino de Enrique Gana Munizaga, no su hijo. Esposo de Blanca Subercaseaux del Río y padre de María Luz Gana Subercaseaux.',source:'https://es.wikipedia.org/wiki/Federico_Gana'},
pedroZanartu:{bio:'Pedro Zañartu y Santa María fue presidente de la Asamblea Provincial de Concepción. Tuvo a Josefa Zañartu Trujillo con Petronila Trujillo y posteriormente se casó con María del Tránsito Zañartu y Arrau.',relation:'Antepasado de Delfina Cruz Zañartu por una rama indirecta; su segundo matrimonio enlaza con la familia Gana.'},
franciscoSubBreton:{bio:'Francisco Subercaseaux Breton (c. 1725–1800) fue médico y marino de la Real Armada Francesa. Llegó a Chile hacia 1757 y se dedicó a la minería y la agricultura en su estancia de Nantoco.',relation:'Tronco común de las dos ramas Subercaseaux que enlazan indirectamente a Mary Rose Mac-Gill con la familia Gana.'},
ramonSubMercado:{bio:'Ramón Subercaseaux Mercado (1790–1859) fue comerciante, propietario de la hacienda Pirque, alcalde de La Serena y senador por Coquimbo y Aconcagua. Presidió el Senado entre 1854 y 1855.',relation:'Antepasado de Julio Subercaseaux Browne y, por esa vía, de Julio Bernardo Subercaseaux Barros.'},
julioSubBrowne:{bio:'Julio Subercaseaux Browne (1870–1951) fue abogado, diputado y propietario del fundo Las Majadas de Pirque.',relation:'Antepasado de Julio Subercaseaux Aldunate y primer esposo de Mary Rose Mac-Gill por su descendencia.'},
william:{bio:'William Cunningham Blest fue médico y político chileno de origen irlandés. Su matrimonio con María de la Luz Gana y López enlazó la rama Gana con la familia Blest Gana.',relation:'Esposo de María de la Luz Gana y padre de Alberto Blest Gana.'},

camila:{bio:'Camila Antonia Amaranta Vallejo Dowling (n. Santiago, 1988) es geógrafa, dirigenta estudiantil y política chilena. Fue presidenta de la Federación de Estudiantes de la Universidad de Chile, diputada por el distrito 26 entre 2014 y 2022 y ministra secretaria general de Gobierno durante la administración de Gabriel Boric.',relation:'Prima del usuario, según dato familiar confirmado; se incorpora como conexión colateral de la rama Vallejo.',image:'https://upload.wikimedia.org/wikipedia/commons/1/1a/Camila_Vallejo_%282022%29.jpg',source:'https://commons.wikimedia.org/wiki/File:Camila_Vallejo_(2022).jpg'},
josefGanaOld:{bio:'José Francisco de Gana y Amézaga (también registrado como Juan Francisco de Gana) pasó a Chile hacia 1745 y se avecindó en Santiago. En 1757 viajó a España y visitó a su familia en Plencia; a su regreso compró en 1764 la estancia Santa Rita de Pirque a Pedro García de la Huerta por 30.000 pesos. Fue capitán de milicias y fundador de la familia Gana en Chile.',relation:'Antepasado directo de Agustín Domingo Gana y Darrigrande; tronco de la línea Gana chilena.'}
};
