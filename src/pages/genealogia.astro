eTy)*ratio;applyTransform()}function zoomAt(factor,cx,cy){setScale(scale*factor,cx,cy)}function zoomBy(factor){zoomAt(factor,viewBoxW/2,viewBoxH/2)}function panBy(dx,dy){tx+=dx;ty+=dy;applyTransform()}function pointerCenter(){const values=[...pointers.values()];return{x:(values[0].x+values[1].x)/2,y:(values[0].y+values[1].y)/2}}function pointerDistance(){const values=[...pointers.values()];return Math.hypot(values[0].x-values[1].x,values[0].y-values[1].y)}document.querySelectorAll('[data-nav]').forEach(b=>b.addEventListener('click',()=>{const action=b.dataset.nav;if(action==='zoomIn')zoomBy(1.2);else if(action==='zoomOut')zoomBy(.83);else if(action==='panUp')panBy(0,viewBoxH*.3);else if(action==='panDown')panBy(0,-viewBoxH*.3);else if(action==='panLeft')panBy(viewBoxW*.3,0);else if(action==='panRight')panBy(-viewBoxW*.3,0);else{scale=initialScale;tx=initialTx;ty=initialTy;applyTransform()}}));svg.addEventListener('wheel',e=>{e.preventDefault();const p=svgPoint(e.clientX,e.clientY);zoomAt(e.deltaY<0?1.12:.89,p.x,p.y)},{passive:false});svg.addEventListener('pointerdown',e=>{if(e.pointerType==='touch'||e.target.closest('.node'))return;e.preventDefault();pointers.set(e.pointerId,{x:e.clientX,y:e.clientY});svg.setPointerCapture(e.pointerId);if(pointers.size===1){drag=true;svg.classList.add('dragging');sx=e.clientX;sy=e.clientY;ox=tx;oy=ty}else if(pointers.size===2){drag=false;pinch={distance:pointerDistance(),center:svgPoint(...Object.values(pointerCenter())),scale,tx,ty};svg.classList.remove('dragging')}});svg.addEventListener('pointermove',e=>{if(e.pointerType==='touch'||!pointers.has(e.pointerId))return;e.preventDefault();pointers.set(e.pointerId,{x:e.clientX,y:e.clientY});if(pointers.size>=2&&pinch){const center=pointerCenter(),currentDistance=pointerDistance(),next=pinch.scale*(currentDistance/pinch.distance),centerSvg=svgPoint(center.x,center.y),startCenter=pinch.center;scale=clampScale(next);const ratio=scale/pinch.scale;tx=startCenter.x-(startCenter.x-pinch.tx)*ratio+(centerSvg.x-startCenter.x);ty=startCenter.y-(startCenter.y-pinch.ty)*ratio+(centerSvg.y-startCenter.y);applyTransform()}else if(drag){const p=pointers.get(e.pointerId);tx=ox+(p.x-sx)*pxToUnits();ty=oy+(p.y-sy)*pxToUnits();applyTransform()}});function endPointer(e){if(e.pointerType==='touch')return;pointers.delete(e.pointerId);if(pointers.size<2)pinch=null;if(pointers.size===1){const p=[...pointers.values()][0];drag=true;sx=p.x;sy=p.y;ox=tx;oy=ty;svg.classList.add('dragging')}else if(!pointers.size){drag=false;svg.classList.remove('dragging')}}svg.addEventListener('pointerup',endPointer);svg.addEventListener('pointercancel',endPointer);let touchDrag=false,touchStartX=0,touchStartY=0,touchOriginX=0,touchOriginY=0,touchPinch=null;function touchCenter(touches){return{x:(touches[0].clientX+touches[1].clientX)/2,y:(touches[0].clientY+touches[1].clientY)/2}}function touchDistance(touches){return Math.hypot(touches[0].clientX-touches[1].clientX,touches[0].clientY-touches[1].clientY)}svg.addEventListener('touchstart',e=>{if(e.target.closest('.node'))return;e.preventDefault();if(e.touches.length===1){const t=e.touches[0];touchDrag=true;touchStartX=t.clientX;touchStartY=t.clientY;touchOriginX=tx;touchOriginY=ty;svg.classList.add('dragging')}else if(e.touches.length>=2){const c=touchCenter(e.touches),p=svgPoint(c.x,c.y);touchDrag=false;touchPinch={distance:touchDistance(e.touches),center:p,scale,tx,ty};svg.classList.remove('dragging')}},{passive:false});svg.addEventListener('touchmove',e=>{if(!touchDrag&&!touchPinch)return;e.preventDefault();if(e.touches.length>=2&&touchPinch){const c=touchCenter(e.touches),p=svgPoint(c.x,c.y),next=touchPinch.scale*(touchDistance(e.touches)/touchPinch.distance);scale=clampScale(next);const ratio=scale/touchPinch.scale;tx=touchPinch.center.x-(touchPinch.center.x-touchPinch.tx)*ratio+(p.x-touchPinch.center.x);ty=touchPinch.center.y-(touchPinch.center.y-touchPinch.ty)*ratio+(p.y-touchPinch.center.y);applyTransform()}else if(e.touches.length===1&&touchDrag){const t=e.touches[0];tx=touchOriginX+(t.clientX-touchStartX)*pxToUnits();ty=touchOriginY+(t.clientY-touchStartY)*pxToUnits();applyTransform()}},{passive:false});svg.addEventListener('touchend',e=>{if(e.touches.length===1){const t=e.touches[0];touchPinch=null;touchDrag=true;touchStartX=t.clientX;touchStartY=t.clientY;touchOriginX=tx;touchOriginY=ty}else if(!e.touches.length){touchDrag=false;touchPinch=null;svg.classList.remove('dragging')}},{passive:false});svg.addEventListener('touchcancel',()=>{touchDrag=false;touchPinch=null;svg.classList.remove('dragging')},{passive:false});applyTransform();refresh();
